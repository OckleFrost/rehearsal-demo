      "duration": 8.237,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 16,
      "sourceEntry": 970,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Put the bucket back.",
      "src": "audio/pages/60/lines/016_parkes_1862bda05d1_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 17,
      "sourceEntry": 971,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY does so. PARKES goes to the sink to wring out his cloth. RODNEY takes another bucket and runs out.",
