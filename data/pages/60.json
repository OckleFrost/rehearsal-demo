      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 7,
      "sourceEntry": 964,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Watch out for funnel-webs. They always come out in the wet.",
      "src": "audio/pages/60/lines/007_pierce_24cd330bb0e_norm.mp3",
      "duration": 3.158,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 8,
      "sourceEntry": 965,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "MONICA drinks her brandy again, quickly.",
      "src": "audio/pages/60/lines/008_director_cc890bb28de_norm.mp3",
      "duration": 1.672,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 965,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You’ve used so much spray out there, Pierce. You must have killed everything by now.",
      "src": "audio/pages/60/lines/009_penny_ff9e97bb6ee_norm.mp3",
      "duration": 4.412,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 10,
      "sourceEntry": 966,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Including us.",
      "src": "audio/pages/60/lines/010_monica_7cbc950be7b_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 11,
      "sourceEntry": 967,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Monica, your constant smoking in a confined space isn’t very pleasant, either.",
      "src": "audio/pages/60/lines/011_pierce_cd735846846_norm.mp3",
      "duration": 4.505,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 12,
      "sourceEntry": 967,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "MONICA puts her cigarette out.",
      "src": "audio/pages/60/lines/012_director_e0c38e087b9_norm.mp3",
      "duration": 1.126,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 13,
      "sourceEntry": 967,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Anyway, spraying is your problem tonight. All I’m saying is....",
      "src": "audio/pages/60/lines/013_pierce_7d85f6853fc_norm.mp3",
      "duration": 3.808,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 14,
      "sourceEntry": 968,
      "speaker": "PENNY_MONICA",
      "kind": "same_text_duet",
      "text": "It’s better to be safe than sorry. Yes, you’ve told us.",
      "src": "audio/pages/60/lines/014_penny_monica_fb91d8f_mix_norm.mp3",
      "duration": 3.762,
      "speed": null,
      "voiceName": "PENNY + MONICA"
    },
    {
      "n": 15,
      "sourceEntry": 970,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PIERCE sighs and lies down again, with his eyes closed. MONICA and PENNY return to their cards. RODNEY runs in with his bucket and empties it. As he tries to exit, PARKES blocks the door.",
