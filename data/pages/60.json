    },
    {
      "n": 6,
      "sourceEntry": 964,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "To Monica",
      "src": "audio/pages/60/lines/006_director_106462ad68e_norm.mp3",
