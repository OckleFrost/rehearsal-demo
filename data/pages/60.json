      "duration": 4.061,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 18,
      "sourceEntry": 971,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Rodney!",
      "src": "audio/pages/60/lines/018_parkes_7b33792819c_norm.mp3",
      "duration": 0.743,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 19,
      "sourceEntry": 972,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Parkes, it’s only a bucket...",
