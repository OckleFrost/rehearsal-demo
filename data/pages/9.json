      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 8,
      "sourceEntry": 78,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "She embraces him. He leaps away and back to the door.",
