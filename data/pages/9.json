      "duration": 11.703,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 19,
      "sourceEntry": 86,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "No! Monica and Parkes could come in. We have to be careful.",
