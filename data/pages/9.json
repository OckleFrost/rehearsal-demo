      "duration": 2.508,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 11,
      "sourceEntry": 80,
      "speaker": "RODNEY",
      "kind": "spoken",
