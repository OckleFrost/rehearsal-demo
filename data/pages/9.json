      "duration": 1.068,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 17,
      "sourceEntry": 84,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Shhhh!!",
      "src": "audio/pages/9/lines/017_rodney_5e4fd9b24ac6bc23_norm.mp3",
      "duration": 0.882,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 18,
      "sourceEntry": 85,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I can’t help it. I’ve never been unfaithful before, Rodney. I’ve never taken a lover before. In all these years. Rodney, please. Kiss me.",
