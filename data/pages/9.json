      "duration": 8.034,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 15,
      "sourceEntry": 82,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "You’re talking very loudly.",
