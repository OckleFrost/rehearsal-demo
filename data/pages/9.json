      "duration": 1.3,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 16,
      "sourceEntry": 83,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I don’t care!",
