  "status": "provisional-existing-render",
  "lines": [
    {
      "n": 1,
      "sourceEntry": 786,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "And if you say that again, I’ll strangle you.",
      "src": "audio/pages/50/lines/001_monica_229d42f2c14_norm.mp3",
      "duration": 2.09,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 2,
      "sourceEntry": 787,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "There’s never been a scratch on this caravan. It’s a practically new caravan.",
      "src": "audio/pages/50/lines/002_parkes_46867743c61_norm.mp3",
      "duration": 3.901,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 3,
      "sourceEntry": 788,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Yes! We know! It’s a lovely caravan. And it leaks! Isn’t that fun!",
      "src": "audio/pages/50/lines/003_monica_1ff7d4b4ab6_norm.mp3",
      "duration": 4.133,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 4,
      "sourceEntry": 789,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "It’s never leaked before.",
      "src": "audio/pages/50/lines/004_parkes_76ffdc35bd7_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 5,
      "sourceEntry": 790,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I suppose you blame us for that, too.",
      "src": "audio/pages/50/lines/005_monica_647bea7b169_norm.mp3",
      "duration": 2.183,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 6,
      "sourceEntry": 791,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Parkes! Monica! Would you please stop squabbling! It doesn’t make it very easy for the rest of us- does it, Rodney?",
      "src": "audio/pages/50/lines/006_penny_ac71de91829_norm.mp3",
      "duration": 7.291,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 7,
      "sourceEntry": 792,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY doesn’t look up from his book.",
      "src": "audio/pages/50/lines/007_director_5db3b214c75_norm.mp3",
      "duration": 1.28,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 8,
      "sourceEntry": 792,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Hmmm?",
      "src": "audio/pages/50/lines/008_rodney_c91c719b533_norm.mp3",
      "duration": 0.697,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 9,
      "sourceEntry": 793,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I’m sorry. I shall try very hard to be nice.",
      "src": "audio/pages/50/lines/009_monica_ad87f672bfd_norm.mp3",
      "duration": 2.508,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 10,
      "sourceEntry": 794,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Just concentrate on the game.",
      "src": "audio/pages/50/lines/010_penny_de9b23fd451_norm.mp3",
      "duration": 1.672,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 11,
      "sourceEntry": 795,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Forgive me for expressing an opinion. In my own caravan.",
      "src": "audio/pages/50/lines/011_parkes_bfd8b7d4be1_norm.mp3",
      "duration": 2.879,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 12,
      "sourceEntry": 796,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Parkes!",
      "src": "audio/pages/50/lines/012_penny_fb93e768d03_norm.mp3",
      "duration": 0.836,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 13,
      "sourceEntry": 797,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Sorry I spoke.",
      "src": "audio/pages/50/lines/013_parkes_e7ca4ab3f57_norm.mp3",
      "duration": 1.115,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 14,
      "sourceEntry": 797,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Pause",
      "src": "audio/pages/50/lines/014_director_360f0c227d7_norm.mp3",
      "duration": 0.59,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 15,
      "sourceEntry": 797,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I can’t believe this caravan is leaking. This is a practically new caravan.",
      "src": "audio/pages/50/lines/015_parkes_bb15ccaabd9_norm.mp3",
      "duration": 3.994,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 16,
      "sourceEntry": 798,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "MONICA thumps the table with her fist. She counts slowly to ten under her breath. PENNY pats her hand warningly.",
      "src": "audio/pages/50/lines/016_director_4dfab57811b_norm.mp3",
      "duration": 4.092,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 17,
      "sourceEntry": 798,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Do you think you could tear yourself away from that book and get us a drink, Rodney dear?",
      "src": "audio/pages/50/lines/017_monica_dce1bd19346_norm.mp3",
      "duration": 4.18,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 18,
      "sourceEntry": 799,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "not looking up",
      "src": "audio/pages/50/lines/018_director_42d66970937_norm.mp3",
      "duration": 0.532,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 19,
      "sourceEntry": 799,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Mmmm?",
      "src": "audio/pages/50/lines/019_rodney_c367e750d26_norm.mp3",
      "duration": 0.604,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 20,
      "sourceEntry": 800,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "My husband’s been such fun on this holiday, hasn’t he? Rodney?",
      "src": "audio/pages/50/lines/020_monica_a1512f64a8b_norm.mp3",
      "duration": 2.926,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 21,
      "sourceEntry": 801,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "still reading",
      "src": "audio/pages/50/lines/021_director_8efbbfaf33d_norm.mp3",
      "duration": 0.646,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 22,
      "sourceEntry": 801,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Yes?",
      "src": "audio/pages/50/lines/022_rodney_128a0c22032_norm.mp3",
      "duration": 0.511,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 23,
      "sourceEntry": 802,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Rodney!",
      "src": "audio/pages/50/lines/023_monica_9e75083e4c3_norm.mp3",
      "duration": 0.743,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 24,
      "sourceEntry": 803,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Yes!",
      "src": "audio/pages/50/lines/024_rodney_8effa925692_norm.mp3",
      "duration": 0.418,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 25,
      "sourceEntry": 804,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Don’t shout at me, please. Penny and I would like a drink.",
      "src": "audio/pages/50/lines/025_monica_7d526662371_norm.mp3",
      "duration": 2.601,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    }
