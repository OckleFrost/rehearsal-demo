  "lines": [
    {
      "n": 1,
      "sourceEntry": 1379,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "When did this happen?",
      "src": "audio/pages/85/lines/001_rodney_aa0e8f42cc3_norm.mp3",
      "duration": 1.161,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 2,
      "sourceEntry": 1380,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Oh, it’s so long ago. I don’t remember. We were drunk.",
      "src": "audio/pages/85/lines/002_monica_fa6865abb47_norm.mp3",
      "duration": 3.019,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 3,
      "sourceEntry": 1381,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "When?",
      "src": "audio/pages/85/lines/003_rodney_7196a2801df_norm.mp3",
      "duration": 0.557,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 4,
      "sourceEntry": 1382,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "One of Pierce’s birthday parties. Under the hedge",
      "src": "audio/pages/85/lines/004_monica_7a6f836924a_norm.mp3",
      "duration": 2.879,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 5,
      "sourceEntry": 1383,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Where’s little Piercie? I want little Piercie.",
      "src": "audio/pages/85/lines/005_gwendolyn_3bf14a6171f_norm.mp3",
      "duration": 2.415,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 6,
      "sourceEntry": 1384,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Gwendolyn, I’m rather tired and you’ve drunk.",
      "src": "audio/pages/85/lines/006_pierce_e676827ddd4_norm.mp3",
      "duration": 2.322,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 7,
      "sourceEntry": 1385,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "That doesn’t seem to have stopped you before.",
      "src": "audio/pages/85/lines/007_rodney_4996636b696_norm.mp3",
      "duration": 1.904,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 8,
      "sourceEntry": 1386,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "You’re tired because you’re forty. I’ve seen your passport.",
      "src": "audio/pages/85/lines/008_gwendolyn_53ce95e0b68_norm.mp3",
      "duration": 3.251,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 9,
      "sourceEntry": 1387,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I could really get to like that girl.",
      "src": "audio/pages/85/lines/009_monica_ec65167e4cc_norm.mp3",
      "duration": 1.904,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 10,
      "sourceEntry": 1388,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Forty is so far away from me. So very far away. I’m only twenty-two.",
      "src": "audio/pages/85/lines/010_gwendolyn_9146663158a_norm.mp3",
      "duration": 4.69,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 11,
      "sourceEntry": 1389,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I’ve just gone off her again.",
      "src": "audio/pages/85/lines/011_monica_a5d63562300_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 12,
      "sourceEntry": 1390,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "She and PENNY laugh. A pause PIERCE gets into the top bunk. He leans over to Gwendolyn.",
      "src": "audio/pages/85/lines/012_director_c9add4af079_norm.mp3",
      "duration": 4.37,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 13,
      "sourceEntry": 1390,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "I am thirty-nine and a half, thank you very much. I am not forty",
      "src": "audio/pages/85/lines/013_pierce_10bf79afafd_norm.mp3",
      "duration": 4.133,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 14,
      "sourceEntry": 1391,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Oh God. I am.",
      "src": "audio/pages/85/lines/014_penny_069cbf0bbd2_norm.mp3",
      "duration": 0.929,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 15,
      "sourceEntry": 1391,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "A silence. They all turn to her. Taking MONICA’S hand",
      "src": "audio/pages/85/lines/015_director_37842fdff59_norm.mp3",
      "duration": 3.131,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 16,
      "sourceEntry": 1391,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You’re my best friend. I want to tell you how old I am!",
      "src": "audio/pages/85/lines/016_penny_53ef827a875_norm.mp3",
      "duration": 3.111,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 17,
      "sourceEntry": 1392,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "You don’t have to completely purge yourself.",
      "src": "audio/pages/85/lines/017_monica_465126af3d5_norm.mp3",
      "duration": 1.904,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 18,
      "sourceEntry": 1393,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "No, if we’re being so honest. I should admit it. I’ve never been able to admit it. Even to myself.",
      "src": "audio/pages/85/lines/018_penny_e119e9a1af6_norm.mp3",
      "duration": 7.105,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 19,
      "sourceEntry": 1393,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Pause",
      "src": "audio/pages/85/lines/019_director_360f0c227d7_norm.mp3",
      "duration": 0.59,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 20,
      "sourceEntry": 1393,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I’m a mature woman. I have to face that. It’s nothing to be ashamed of. I should be proud of my…. age.",
      "src": "audio/pages/85/lines/020_penny_3118d0695cb_norm.mp3",
      "duration": 7.709,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 21,
      "sourceEntry": 1394,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "Pause. They all wait expectantly. PENNY takes a deep breath. I’m...f…f…f…f… (She wipes her brow.) I’m perspiring.....I’m f…. f…f…..f….. (She gags.) I think I’m going to be sick. I’m f…f…forty… (Pause) One! There. I’ve said it. (Looks at them in horror) Oh God, what have I done? (Starts to cry.) I should never have told you. You’ll never let me forget it. (Wails) I don’t want to be f…that age.",
      "src": "audio/pages/85/lines/021_director_39501c6cc25_norm.mp3",
      "duration": 24.676,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 22,
      "sourceEntry": 1394,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I thought you were older than that.",
      "src": "audio/pages/85/lines/022_monica_b74a3328e02_norm.mp3",
      "duration": 1.765,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 23,
      "sourceEntry": 1395,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "outraged",
      "src": "audio/pages/85/lines/023_director_c0f96e01189_norm.mp3",
      "duration": 0.674,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 24,
      "sourceEntry": 1395,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You mean I look older?",
      "src": "audio/pages/85/lines/024_penny_9f409ad39b3_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 25,
      "sourceEntry": 1396,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "No, no, you don’t look it. You’re not forty surely.",
      "src": "audio/pages/85/lines/025_gwendolyn_20d32dea8bf_norm.mp3",
      "duration": 2.786,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 26,
      "sourceEntry": 1397,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I like her.",
      "src": "audio/pages/85/lines/026_penny_7b60d75a51f_norm.mp3",
      "duration": 0.975,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    }
  ],
