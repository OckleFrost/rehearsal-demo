      "n": 1,
      "sourceEntry": 844,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "What’s she talking about?",
      "src": "audio/pages/53/lines/001_rodney_92f51809959_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 2,
      "sourceEntry": 845,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Oh, read your book, Rodney!",
      "src": "audio/pages/53/lines/002_penny_45efeac6c85_norm.mp3",
      "duration": 1.625,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 3,
      "sourceEntry": 846,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY puzzled, returns to his book.",
      "src": "audio/pages/53/lines/003_director_61724c0345a_norm.mp3",
      "duration": 1.485,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 4,
      "sourceEntry": 846,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Well, of course, you’ve got the double bed.",
      "src": "audio/pages/53/lines/004_parkes_3c1173f4cc5_norm.mp3",
      "duration": 2.09,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 5,
      "sourceEntry": 847,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "You can have it back, Parkes. It’s about your turn.",
      "src": "audio/pages/53/lines/005_monica_6880645c135_norm.mp3",
      "duration": 2.694,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 6,
      "sourceEntry": 848,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before_recovered_line",
      "text": "PARKES laughing and nudging PENNY.",
      "src": "audio/pages/53/lines/007_director_2984cf5577b_norm.mp3",
      "duration": 1.204,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 7,
      "sourceEntry": 848,
      "speaker": "PARKES",
      "kind": "spoken_recovered_from_stage_before",
      "text": "It certainly is, eh girl?",
      "src": "audio/pages/53/lines/008_parkes_d66cbe47dd8_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 8,
      "sourceEntry": 848,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY looks up. Now PENNY is embarrassed.",
      "src": "audio/pages/53/lines/009_director_9ac4704f6c5_norm.mp3",
      "duration": 1.691,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 848,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Yes, dear.",
      "src": "audio/pages/53/lines/010_penny_cc0fad32cda_norm.mp3",
      "duration": 0.929,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 10,
      "sourceEntry": 849,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I haven’t noticed you crawling into her bunk, Parkes.",
      "src": "audio/pages/53/lines/011_monica_2e088b19e29_norm.mp3",
      "duration": 2.879,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 11,
      "sourceEntry": 850,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Do you really think that’s what they’re doing out there? In a cave?",
      "src": "audio/pages/53/lines/012_parkes_2fd2c8600f0_norm.mp3",
      "duration": 2.879,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 12,
      "sourceEntry": 851,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Probably. Pierce is very lovey dovey with her. I wonder if he’ll ever grow up. He’ll be onto schoolgirls soon.",
      "src": "audio/pages/53/lines/013_monica_21d6fadba43_norm.mp3",
      "duration": 6.548,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 13,
      "sourceEntry": 852,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Lucky Pierce.",
      "src": "audio/pages/53/lines/014_parkes_bf764a7f591_norm.mp3",
      "duration": 0.975,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 14,
      "sourceEntry": 853,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "MONICA and PENNY look at him curiously.",
      "src": "audio/pages/53/lines/015_director_d059cc1f139_norm.mp3",
      "duration": 1.393,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 15,
      "sourceEntry": 853,
      "speaker": "PARKES",
      "kind": "spoken_parse_wrap_fix",
      "text": "He has a very good time. He’s not married, no responsibilities, no children. He can do what he likes. And he pulls all the young birds.",
      "src": "audio/pages/53/lines/016_parkes_1a2be073cbd_norm.mp3",
      "duration": 6.78,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 16,
      "sourceEntry": 854,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "He’s starting to look ridiculous. At forty, he should have settled down.",
      "src": "audio/pages/53/lines/017_penny_13eaefe4ee3_norm.mp3",
      "duration": 5.526,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 17,
      "sourceEntry": 855,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "laughs",
      "src": "audio/pages/53/lines/018_director_893db649c2a_norm.mp3",
      "duration": 0.62,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 18,
      "sourceEntry": 855,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "She thinks he’s thirty six. She thinks we’re all thirty six.",
      "src": "audio/pages/53/lines/019_parkes_fabd091ba7c_norm.mp3",
      "duration": 3.437,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 19,
      "sourceEntry": 856,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Yes. She’s not the brightest little thing.",
      "src": "audio/pages/53/lines/020_monica_c20c2d1b337_norm.mp3",
      "duration": 1.811,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 20,
      "sourceEntry": 857,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I don’t think we look bad for our ages. Any of us.",
      "src": "audio/pages/53/lines/021_parkes_3c5c83cbad0_norm.mp3",
      "duration": 2.647,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 21,
      "sourceEntry": 858,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "We don’t look as young as you, Parkes. But thank you for including us.",
      "src": "audio/pages/53/lines/022_monica_66f8362b95c_norm.mp3",
      "duration": 3.715,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 22,
      "sourceEntry": 859,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PARKES looks at himself in the mirror.",
      "src": "audio/pages/53/lines/023_director_c9b26cecf5e_norm.mp3",
      "duration": 1.21,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 23,
      "sourceEntry": 859,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "proudly",
      "src": "audio/pages/53/lines/024_director_076b5bec95c_norm.mp3",
      "duration": 0.527,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 24,
      "sourceEntry": 859,
      "speaker": "PARKES",
      "kind": "spoken_parse_stage_split",
      "text": "She thinks I’m thirty six.",
      "src": "audio/pages/53/lines/025_parkes_c8d27b41d06_norm.mp3",
      "duration": 1.486,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 25,
      "sourceEntry": 859,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_after_parse_split",
      "text": "This makes even RODNEY look up.",
      "src": "audio/pages/53/lines/026_director_dbd24140f94_norm.mp3",
      "duration": 1.457,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 26,
      "sourceEntry": 860,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "We may look good for our ages, but we don’t look thirty six, Parkes, believe me.",
      "src": "audio/pages/53/lines/027_monica_45243c6bf84_norm.mp3",
      "duration": 4.69,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 27,
      "sourceEntry": 861,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "brightly",
      "src": "audio/pages/53/lines/028_director_f6cc1935563_norm.mp3",
      "duration": 0.397,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 28,
      "sourceEntry": 861,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I don’t feel any older than thirty six.",
      "src": "audio/pages/53/lines/029_penny_654a70a6eb6_norm.mp3",
      "duration": 2.322,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    }
  ],
