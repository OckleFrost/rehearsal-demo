    {
      "n": 1,
      "sourceEntry": 245,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "That one! God, we no sooner got rid of her and we’ve got another one on her hands. What’s she like?",
      "src": "audio/pages/19/lines/001_monica_41b2f07cf5dc8379_norm.mp3",
      "duration": 4.969,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 2,
      "sourceEntry": 246,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "We haven’t met her.",
      "src": "audio/pages/19/lines/002_penny_f1e4b35f9a5f5adc_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 3,
      "sourceEntry": 247,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "He’s only known her a week.",
      "src": "audio/pages/19/lines/003_parkes_6aeeffd4d553607d_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 4,
      "sourceEntry": 248,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "A week!",
      "src": "audio/pages/19/lines/004_monica_74609976afe68b1d_norm.mp3",
      "duration": 0.789,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 5,
      "sourceEntry": 249,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "He’s bringing a total stranger?",
      "src": "audio/pages/19/lines/005_rodney_8b39c130c6ad08d1_norm.mp3",
      "duration": 1.533,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 6,
      "sourceEntry": 250,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "He insisted on bringing her. He says as a bachelor he’d feel out of it on a holiday with two married couples.",
      "src": "audio/pages/19/lines/006_penny_093cdcf8cb045318_norm.mp3",
      "duration": 6.641,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 7,
      "sourceEntry": 251,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "He’s always enjoyed our company before.",
      "src": "audio/pages/19/lines/007_rodney_eb68bdb32d10056c_norm.mp3",
      "duration": 1.997,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 8,
      "sourceEntry": 252,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "And we’ve put up with his endless stream of dolly birds for years. They get younger and younger. The last one was thirty!",
      "src": "audio/pages/19/lines/008_monica_36e6493a8615faba_norm.mp3",
      "duration": 7.43,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 9,
      "sourceEntry": 253,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Monica, thirty isn’t young. It’s not so very long ago since we were thirty....",
      "src": "audio/pages/19/lines/009_penny_003277e7a279f7b2_norm.mp3",
      "duration": 5.898,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 10,
      "sourceEntry": 254,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "She stops, afraid she might give her age away.",
      "src": "audio/pages/19/lines/010_director_cfd1758bbd8362c3_norm.mp3",
      "duration": 1.835,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 11,
      "sourceEntry": 254,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "But we don’t know her. We won’t be able to be ourselves. She’s an intrusion.",
      "src": "audio/pages/19/lines/011_rodney_67031d3ed12e9887_norm.mp3",
      "duration": 3.251,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 12,
      "sourceEntry": 255,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "This is typical of Pierce. Totally selfish. It’s our holiday.",
      "src": "audio/pages/19/lines/012_monica_a6eabfc8da89d50b_norm.mp3",
      "duration": 3.065,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 13,
      "sourceEntry": 256,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Oh, it’ll be all right. You don’t have to talk much on the beach. And at night, we’ll put them in the annexe.",
      "src": "audio/pages/19/lines/013_parkes_7f70c44ad6515b79_norm.mp3",
      "duration": 5.387,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 14,
      "sourceEntry": 257,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY & PENNY react to this.",
      "src": "audio/pages/19/lines/014_director_cd29d67fefb049e0_norm.mp3",
      "duration": 1.206,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 15,
      "sourceEntry": 257,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Goodie. I wonder if they’re noisy. I hope they’re not noisy.",
      "src": "audio/pages/19/lines/015_monica_ba4534e23ccc7576_norm.mp3",
      "duration": 2.786,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 16,
      "sourceEntry": 258,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Noisy?",
      "src": "audio/pages/19/lines/016_parkes_ab4fe4c8bbb3cfd2_norm.mp3",
      "duration": 0.789,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 17,
      "sourceEntry": 258,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Pause",
      "src": "audio/pages/19/lines/017_director_42c82360f0c227d7_norm.mp3",
      "duration": 0.59,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 18,
      "sourceEntry": 258,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "You mean, when they’re.....ha,ha,ha. You’re a card, Monica. Ha, ha. I don’t know about them but I certainly am.",
      "src": "audio/pages/19/lines/018_parkes_6326470a343a5751_norm.mp3",
      "duration": 6.409,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 19,
      "sourceEntry": 258,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "He grabs PENNY pulling her to him",
      "src": "audio/pages/19/lines/019_director_3d99d9707995bdca_norm.mp3",
      "duration": 1.203,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 20,
      "sourceEntry": 258,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Aren’t I darling? You’ll have to get used to us. We’re at it all the time.",
      "src": "audio/pages/19/lines/020_parkes_d55faf6fea50854c_norm.mp3",
      "duration": 3.251,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 21,
      "sourceEntry": 259,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Really?",
      "src": "audio/pages/19/lines/021_rodney_7bb3a8480f774b8d_norm.mp3",
      "duration": 0.65,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 22,
      "sourceEntry": 260,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "embarrassed",
      "src": "audio/pages/19/lines/022_director_c4e2b56cbcc78d34_norm.mp3",
      "duration": 0.71,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 23,
      "sourceEntry": 260,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Don’t exaggerate, Parkes. We’re not, you know.",
      "src": "audio/pages/19/lines/023_penny_cafec58d58e137eb_norm.mp3",
      "duration": 2.694,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 24,
      "sourceEntry": 261,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "You’d better have the double bed then.",
      "src": "audio/pages/19/lines/024_monica_a810fd0befa64ae2_norm.mp3",
      "duration": 1.904,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 25,
      "sourceEntry": 262,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "No, no. You’re our guests. You have the double bed.",
      "src": "audio/pages/19/lines/025_parkes_fbf46b5a776fe894_norm.mp3",
      "duration": 2.926,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    }
  ]
