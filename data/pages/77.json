      "duration": 9.056,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 9,
      "sourceEntry": 1241,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "They embrace, sobbing.",
      "src": "audio/pages/77/lines/009_director_de495fd8465_norm.mp3",
      "duration": 0.961,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 10,
      "sourceEntry": 1241,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I would.",
