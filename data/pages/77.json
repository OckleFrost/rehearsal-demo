      "duration": 2.786,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 6,
      "sourceEntry": 1239,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "She struggles to get one leg on the bunk and succeeds. She stays in that position.",
      "src": "audio/pages/77/lines/006_director_062ed89c233_norm.mp3",
      "duration": 3.374,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 7,
      "sourceEntry": 1239,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Lovely!",
      "src": "audio/pages/77/lines/007_gwendolyn_388dcbdd9d1_norm.mp3",
      "duration": 0.789,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 8,
      "sourceEntry": 1240,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Yes, you are, Monica, you’re nice. And understanding. But don’t be. You’d never do to me what I did to you.",
