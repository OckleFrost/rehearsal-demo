      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 12,
      "sourceEntry": 1243,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I would, I would.",
      "src": "audio/pages/77/lines/012_monica_5d3c546af73_norm.mp3",
      "duration": 1.115,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 13,
      "sourceEntry": 1244,
