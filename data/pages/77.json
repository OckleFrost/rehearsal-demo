      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 3,
      "sourceEntry": 1236,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "No, no. You are one of the world’s truly nice people. You’re as nice as Gwendolyn.",
      "src": "audio/pages/77/lines/003_penny_7068f77c149_norm.mp3",
      "duration": 6.362,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 4,
      "sourceEntry": 1237,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Oh God, don’t say that!",
      "src": "audio/pages/77/lines/004_monica_5fc083dd5ea_norm.mp3",
      "duration": 1.254,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 5,
      "sourceEntry": 1238,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Gwendolyn is a truly lovely nicely person.",
