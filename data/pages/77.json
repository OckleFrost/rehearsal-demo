      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 11,
      "sourceEntry": 1242,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "No, you wouldn’t.",
      "src": "audio/pages/77/lines/011_penny_b504a740ff5_norm.mp3",
