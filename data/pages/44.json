    {
      "n": 7,
      "sourceEntry": 693,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PIERCE and GWENDOLYN exit. RODNEY bangs his head silently on the table.",
      "src": "audio/pages/44/lines/007_director_2921a22f65a_norm.mp3",
      "duration": 2.912,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 8,
      "sourceEntry": 693,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "in a groaning whisper",
      "src": "audio/pages/44/lines/008_director_d1657440f50_norm.mp3",
      "duration": 0.848,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 693,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Oh hell. They know. They know.",
      "src": "audio/pages/44/lines/009_rodney_5a0354f1a23_norm.mp3",
      "duration": 1.533,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 10,
      "sourceEntry": 694,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "in a bright whisper",
      "src": "audio/pages/44/lines/010_director_86d15fb5673_norm.mp3",
      "duration": 0.718,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 11,
      "sourceEntry": 694,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Don’t be silly. Of course they don’t.",
      "src": "audio/pages/44/lines/011_penny_5bfaba25ae7_norm.mp3",
      "duration": 2.647,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 12,
      "sourceEntry": 695,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Don’t be stupid. Of course they do.",
      "src": "audio/pages/44/lines/012_rodney_3dbf047346a_norm.mp3",
      "duration": 1.579,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 13,
      "sourceEntry": 696,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "very, very brightly",
      "src": "audio/pages/44/lines/013_director_1b2730525d2_norm.mp3",
      "duration": 0.775,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 14,
      "sourceEntry": 696,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "No, they don’t. I’m certain they don’t. They don’t know. I’m sure they don’t know.",
      "src": "audio/pages/44/lines/014_penny_662e94c756e_norm.mp3",
      "duration": 6.177,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 15,
      "sourceEntry": 697,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "You shut your eyes to everything! You’re never honest. We have been discovered. They know.",
      "src": "audio/pages/44/lines/015_rodney_3b58e0c51b4_norm.mp3",
      "duration": 4.273,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 16,
      "sourceEntry": 698,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "desperately brightly",
      "src": "audio/pages/44/lines/016_director_442423dea55_norm.mp3",
      "duration": 0.748,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 17,
      "sourceEntry": 698,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Why do you think they know!",
      "src": "audio/pages/44/lines/017_penny_c759d63d8d2_norm.mp3",
      "duration": 1.672,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 18,
      "sourceEntry": 699,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "exasperated",
      "src": "audio/pages/44/lines/018_director_b3a4d88b61c_norm.mp3",
      "duration": 0.626,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 19,
      "sourceEntry": 699,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "For one thing, you didn’t make the bloody bed!",
      "src": "audio/pages/44/lines/019_rodney_1d58a69e5b5_norm.mp3",
      "duration": 2.09,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 20,
      "sourceEntry": 700,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PENNY’S bright smile fades. She looks worried.",
      "src": "audio/pages/44/lines/020_director_845cf774b4d_norm.mp3",
      "duration": 1.694,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 21,
      "sourceEntry": 700,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Pierce will understand. He’s our friend.",
      "src": "audio/pages/44/lines/021_penny_e163c5e1e81_norm.mp3",
      "duration": 2.508,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 22,
      "sourceEntry": 701,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "If he tells Monica. Or Parkes....",
      "src": "audio/pages/44/lines/022_rodney_62d2270982a_norm.mp3",
      "duration": 1.904,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 23,
      "sourceEntry": 702,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "He won’t! I’m sure he won’t! It’s not as if we were doing very much, Rodney.",
      "src": "audio/pages/44/lines/023_penny_da614ab9362_norm.mp3",
      "duration": 5.851,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 24,
      "sourceEntry": 703,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "We looked as if we were doing the lot!",
      "src": "audio/pages/44/lines/024_rodney_fd50a9601e4_norm.mp3",
      "duration": 1.811,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 25,
      "sourceEntry": 704,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "A LOUD WAIL from outside and a shriek from GWENDOLYN. MONICA bursts in, wearing only a large towel. PIERCE and GWENDOLYN follow.",
      "src": "audio/pages/44/lines/025_director_2ab101db2e8_norm.mp3",
      "duration": 5.573,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 26,
      "sourceEntry": 704,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Ahher! Ah...er....ah....",
      "src": "audio/pages/44/lines/026_monica_e0731f68f38_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 27,
      "sourceEntry": 705,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Monica! You trod on Gwendolyn.",
