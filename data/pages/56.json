      "duration": 0.696,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 7,
      "sourceEntry": 901,
      "speaker": "PENNY",
      "kind": "spoken_parse_stage_split",
      "text": "I’m fine! I’m absolutely fine!",
      "src": "audio/pages/56/lines/007_penny_1894e08e741_norm.mp3",
      "duration": 2.276,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 8,
      "sourceEntry": 901,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_after_parse_split",
      "text": "Noises off. GWENDOLYN and PIERCE have returned.",
      "src": "audio/pages/56/lines/008_director_86d7d7a3188_norm.mp3",
      "duration": 2.326,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 902,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Oh, it’s full of water!",
      "src": "audio/pages/56/lines/009_gwendolyn_97dcf3f6df7_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 10,
      "sourceEntry": 903,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "We’re not sleeping in this!",
      "src": "audio/pages/56/lines/010_pierce_675ed8b7431_norm.mp3",
      "duration": 1.533,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 11,
      "sourceEntry": 904,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "It’s all right. It’s all right! I’m cleaning it up for you.",
      "src": "audio/pages/56/lines/011_parkes_1f77699ce72_norm.mp3",
      "duration": 2.972,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 12,
      "sourceEntry": 905,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PARKES runs in and wrings a cloth into a bucket. PIERCE and GWENDOLYN enter in large fisherman’s raincoats, gumboots and rain hats.",
      "src": "audio/pages/56/lines/012_director_1d8ae0f6665_norm.mp3",
      "duration": 4.919,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 13,
      "sourceEntry": 905,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "We’re not sleeping out there again. I’ve already got a very bad cold.",
      "src": "audio/pages/56/lines/013_pierce_228b07d4fcc_norm.mp3",
      "duration": 4.365,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 14,
      "sourceEntry": 906,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I’m cleaning it up! I’ve only got two hands.",
      "src": "audio/pages/56/lines/014_parkes_f14d6b190d5_norm.mp3",
      "duration": 2.183,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 15,
      "sourceEntry": 906,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "To RODNEY",
      "src": "audio/pages/56/lines/015_director_09ff67523c0_norm.mp3",
      "duration": 0.576,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 16,
      "sourceEntry": 906,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "If some people would get off their bums instead of reading....",
      "src": "audio/pages/56/lines/016_parkes_f4726c5f889_norm.mp3",
      "duration": 2.74,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 17,
      "sourceEntry": 907,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Mmmm?",
      "src": "audio/pages/56/lines/017_rodney_c367e750d26_norm.mp3",
      "duration": 0.65,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 18,
      "sourceEntry": 908,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "I’ll help you later, Parkes.",
      "src": "audio/pages/56/lines/018_pierce_6c59146b47d_norm.mp3",
      "duration": 1.579,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 19,
      "sourceEntry": 909,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I won’t hold my breath.",
      "src": "audio/pages/56/lines/019_parkes_c6415347362_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 20,
      "sourceEntry": 910,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PARKES runs out to the annexe with his cloth.",
      "src": "audio/pages/56/lines/020_director_c1f0803750a_norm.mp3",
      "duration": 1.803,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 21,
      "sourceEntry": 910,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "I’d like to help, I really would, but I have to lie down. I’m not well.",
      "src": "audio/pages/56/lines/021_pierce_632aa2e04ed_norm.mp3",
      "duration": 4.365,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 22,
      "sourceEntry": 911,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "He staggers to the double bed and lies down.",
      "src": "audio/pages/56/lines/022_director_1520e57ebb6_norm.mp3",
      "duration": 1.664,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 23,
      "sourceEntry": 911,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "You shouldn’t go out in the rain so much, Pierce. Then you wouldn’t catch cold.",
      "src": "audio/pages/56/lines/023_monica_2c46420d281_norm.mp3",
      "duration": 4.087,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 24,
      "sourceEntry": 912,
      "speaker": "PENNY",
