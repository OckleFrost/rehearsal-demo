    {
      "n": 2,
      "sourceEntry": 89,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I’m terribly sorry. You’re right, of course.",
      "src": "audio/pages/10/lines/002_penny_ac61b7ade5a70799_norm.mp3",
      "duration": 2.415,
      "speed": null,
