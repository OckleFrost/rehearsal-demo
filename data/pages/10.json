    },
    {
      "n": 3,
      "sourceEntry": 90,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "We can’t, can we?",
      "src": "audio/pages/10/lines/003_rodney_4b00196fa3be8040_norm.mp3",
      "duration": 1.161,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 4,
      "sourceEntry": 91,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "No. Of course we can’t.",
      "src": "audio/pages/10/lines/004_penny_e7132edfb6fcca69_norm.mp3",
      "duration": 1.579,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 5,
      "sourceEntry": 92,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "It would be ridiculous.",
      "src": "audio/pages/10/lines/005_rodney_57580c7367207a11_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 6,
      "sourceEntry": 93,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Yes. It would be.",
      "src": "audio/pages/10/lines/006_penny_40a11d936c3cc795_norm.mp3",
      "duration": 1.672,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 7,
      "sourceEntry": 93,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Pause.",
      "src": "audio/pages/10/lines/007_director_1e77c71260524fbc_norm.mp3",
      "duration": 0.529,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 8,
      "sourceEntry": 93,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You don’t want to? Ever again?",
      "src": "audio/pages/10/lines/008_penny_5ad7957459c5b1ab_norm.mp3",
      "duration": 2.322,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 9,
      "sourceEntry": 94,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I didn’t say that.",
      "src": "audio/pages/10/lines/009_rodney_c63db2a9f8480f59_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 10,
      "sourceEntry": 95,
      "speaker": "PENNY",
      "kind": "spoken_parse_wrap_fix",
      "text": "Then what do you want? I don’t know where I stand with you, Rodney.",
      "src": "audio/pages/10/lines/010_penny_d6954b024f48d43b_norm.mp3",
      "duration": 4.365,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 11,
      "sourceEntry": 95,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "She tries to hold him. He backs away.",
      "src": "audio/pages/10/lines/011_director_4bc0539ee3af8895_norm.mp3",
      "duration": 1.541,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 12,
      "sourceEntry": 95,
      "speaker": "PENNY",
      "kind": "spoken_parse_wrap_fix",
      "text": "All right. I’ll be good. I know how to be good. I’ve been good for years. I mean, Parkes and I....hardly ever. Twice a year, maybe.",
      "src": "audio/pages/10/lines/012_penny_2ed6f7e38c4b42e4_norm.mp3",
      "duration": 13.421,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 13,
      "sourceEntry": 96,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Twice a year?",
      "src": "audio/pages/10/lines/014_rodney_06abd50f02c00a13_norm.mp3",
      "duration": 1.022,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 14,
      "sourceEntry": 97,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "We’ve been married fifteen years. You can’t expect passion after fifteen years. Can you?",
      "src": "audio/pages/10/lines/015_penny_b5df34f6a80acebd_norm.mp3",
      "duration": 5.341,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 15,
      "sourceEntry": 98,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I suppose not.",
      "src": "audio/pages/10/lines/016_rodney_bfa871214ec213a7_norm.mp3",
      "duration": 1.022,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 16,
      "sourceEntry": 98,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "A pause",
      "src": "audio/pages/10/lines/017_director_3ecdba628a1669b9_norm.mp3",
      "duration": 0.651,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 17,
      "sourceEntry": 98,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Twice a year! Only twice a year?",
      "src": "audio/pages/10/lines/018_rodney_a5552bb92b75e3a3_norm.mp3",
      "duration": 1.718,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 18,
      "sourceEntry": 99,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I don’t really keep count. That’s what marriage is about after a long time. You settle for other things. Like companionship. And shared interests.",
      "src": "audio/pages/10/lines/019_penny_88d2bbf2380049b1_norm.mp3",
      "duration": 10.403,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 19,
      "sourceEntry": 99,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Laughs",
      "src": "audio/pages/10/lines/020_director_ca821ff8b969f45d_norm.mp3",
      "duration": 0.718,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 20,
      "sourceEntry": 99,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "We’re not abnormal.",
      "src": "audio/pages/10/lines/021_penny_6753d4f8dec8a884_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 21,
      "sourceEntry": 99,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "A pause",
      "src": "audio/pages/10/lines/022_director_3ecdba628a1669b9_norm.mp3",
      "duration": 0.651,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 22,
      "sourceEntry": 99,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "How often do you and Monica?",
      "src": "audio/pages/10/lines/023_penny_7cb6fa523aae91df_norm.mp3",
      "duration": 1.718,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 23,
      "sourceEntry": 100,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I don’t think we should talk about this.",
      "src": "audio/pages/10/lines/024_rodney_87625475c6959e76_norm.mp3",
      "duration": 1.904,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 24,
      "sourceEntry": 101,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "More than twice a year?",
      "src": "audio/pages/10/lines/025_penny_0aea7ccc051560ab_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 25,
      "sourceEntry": 102,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "A bit more than that, yes.",
      "src": "audio/pages/10/lines/026_rodney_a12449cb9e74dc73_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 26,
      "sourceEntry": 103,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "How often?",
      "src": "audio/pages/10/lines/027_penny_0bbe5fd4a2fad4cc_norm.mp3",
      "duration": 0.975,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 27,
      "sourceEntry": 104,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "About twice. A week.",
      "src": "audio/pages/10/lines/028_rodney_ea973f4e18d64c68_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 28,
      "sourceEntry": 105,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Horrified",
      "src": "audio/pages/10/lines/029_director_abe076a8d6f3074b_norm.mp3",
      "duration": 0.674,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 29,
      "sourceEntry": 105,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I am abnormal! What’s wrong with me?",
      "src": "audio/pages/10/lines/030_penny_37143af5b9d0b980_norm.mp3",
      "duration": 2.368,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 30,
      "sourceEntry": 106,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "What’s wrong with Parkes?",
      "src": "audio/pages/10/lines/031_rodney_07a67317584ad680_norm.mp3",
      "duration": 1.161,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 31,
      "sourceEntry": 107,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You think there’s something wrong with him?",
      "src": "audio/pages/10/lines/032_penny_75b523c440a517ed_norm.mp3",
      "duration": 1.95,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 32,
      "sourceEntry": 108,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "No, no. Everybody’s different.",
      "src": "audio/pages/10/lines/033_rodney_3d1fc2fd0cd9e68c_norm.mp3",
      "duration": 1.486,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
