      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 8,
      "sourceEntry": 58,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Parkes is showing her where he used to have the caravan. Somebody’s taken his spot apparently.",
      "src": "audio/pages/8/lines/008_rodney_23eb08726cf9855c_norm.mp3",
      "duration": 4.458,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 9,
      "sourceEntry": 59,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PENNY shuts the door. She stands against it, waiting expectantly. RODNEY looks at her nervously.",
      "src": "audio/pages/8/lines/009_director_8568987378a18c47_norm.mp3",
      "duration": 4.177,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 10,
      "sourceEntry": 59,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Darling?",
      "src": "audio/pages/8/lines/010_penny_fad01d76707ceca9_norm.mp3",
      "duration": 0.882,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 11,
      "sourceEntry": 60,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Yes?",
      "src": "audio/pages/8/lines/011_rodney_2a7c3128a0c22032_norm.mp3",
      "duration": 0.511,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 12,
      "sourceEntry": 61,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Don’t I get a kiss?",
      "src": "audio/pages/8/lines/012_penny_a008e975abc640eb_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 13,
      "sourceEntry": 61,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "She stands expectantly. RODNEY quickly pecks her and leaps away when she tried to embrace him.",
      "src": "audio/pages/8/lines/013_director_d73e01af7f08f795_norm.mp3",
      "duration": 3.87,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 14,
      "sourceEntry": 61,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "That’s not much of a kiss.",
      "src": "audio/pages/8/lines/014_penny_49f2b712c8437996_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 15,
      "sourceEntry": 62,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY nervously looks out the door.",
      "src": "audio/pages/8/lines/015_director_b1eeb3952b99791f_norm.mp3",
      "duration": 1.406,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 16,
      "sourceEntry": 62,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Well. Here we are.",
      "src": "audio/pages/8/lines/016_rodney_e096747556b2166e_norm.mp3",
      "duration": 1.115,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 17,
      "sourceEntry": 62,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Laughs nervously",
      "src": "audio/pages/8/lines/017_director_25933a18c5c34a0e_norm.mp3",
      "duration": 0.779,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 18,
      "sourceEntry": 62,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "God that’s a long drive, though. Monica almost passed out in the heat. Why are you looking at me like that?",
      "src": "audio/pages/8/lines/018_rodney_f9f44f3239f4ed8d_norm.mp3",
      "duration": 5.016,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 19,
      "sourceEntry": 63,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I’m sorry, Rodney. I have to say it. I’m very hurt.",
      "src": "audio/pages/8/lines/019_penny_7db33b0468c55384_norm.mp3",
      "duration": 3.622,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 20,
      "sourceEntry": 64,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Touching head innocently",
      "src": "audio/pages/8/lines/020_director_cf9d5aee3732968b_norm.mp3",
      "duration": 0.997,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 21,
      "sourceEntry": 64,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Hurt? Why?",
      "src": "audio/pages/8/lines/021_rodney_78b19910dacb5141_norm.mp3",
      "duration": 0.789,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 22,
      "sourceEntry": 65,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "It’s been two weeks. You never rang.",
      "src": "audio/pages/8/lines/022_penny_c19abc5e3f77746f_norm.mp3",
      "duration": 2.972,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 23,
      "sourceEntry": 66,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I’ve been very busy, Penny. There’s a whole new...er... and we’re up to...er...and really, there’s been no time. Really.",
      "src": "audio/pages/8/lines/023_rodney_8d53c4de8a949cef_norm.mp3",
      "duration": 6.223,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 24,
      "sourceEntry": 67,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "He runs down. Pause.",
      "src": "audio/pages/8/lines/024_director_95c384626fe42f62_norm.mp3",
      "duration": 1.129,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 25,
      "sourceEntry": 67,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You’re feeling guilty?",
      "src": "audio/pages/8/lines/025_penny_c65230490cdaf5dc_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 26,
      "sourceEntry": 68,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Just a little bit, yes.",
      "src": "audio/pages/8/lines/026_rodney_ed1f70408e0f38da_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 27,
      "sourceEntry": 69,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "How do you think I feel? Monica’s my best friend.",
      "src": "audio/pages/8/lines/027_penny_e38350749850babc_norm.mp3",
      "duration": 3.622,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 28,
      "sourceEntry": 70,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I know! And if she ever found out.....",
      "src": "audio/pages/8/lines/028_rodney_9749e96c2de4dc52_norm.mp3",
      "duration": 1.904,
      "speed": null,
