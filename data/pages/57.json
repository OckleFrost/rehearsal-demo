  "lines": [
    {
      "n": 1,
      "sourceEntry": 914,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "GWENDOLYN giggles, looks at the floor. MONICS and PENNY watch her.",
      "src": "audio/pages/57/lines/001_director_819dc723adb_norm.mp3",
      "duration": 2.51,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 2,
      "sourceEntry": 914,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Gwendolyn doesn’t look tired. She looks quite rested. Did you have a lovely day, Gwendolyn?",
      "src": "audio/pages/57/lines/002_monica_ce0a01522fd_norm.mp3",
      "duration": 5.387,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 3,
      "sourceEntry": 915,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Oh, it was lovely. It’s so lovely out there! It was so exciting. The sky was dark, the seas were pounding...",
      "src": "audio/pages/57/lines/003_gwendolyn_b2870cf7ddb_norm.mp3",
      "duration": 7.059,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 4,
      "sourceEntry": 916,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Your little heart was beating....",
      "src": "audio/pages/57/lines/004_monica_09242da47b9_norm.mp3",
      "duration": 1.904,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 5,
      "sourceEntry": 917,
      "speaker": "GWENDOLYN",
      "kind": "spoken_parse_stage_split",
      "text": "It was! We walked right to the end of the beach. We found a lovely cave!",
      "src": "audio/pages/57/lines/005_gwendolyn_786adae3855_norm.mp3",
      "duration": 4.783,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 6,
      "sourceEntry": 917,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_after_parse_split",
      "text": "MONICA, PENNY and RODNEY stop what they’re doing and stare at her. PARKES pokes his head around the door.",
      "src": "audio/pages/57/lines/006_director_7c720f30457_norm.mp3",
      "duration": 3.534,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 7,
      "sourceEntry": 918,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "yawns",
      "src": "audio/pages/57/lines/007_director_31809f88269_norm.mp3",
      "duration": 0.686,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 8,
      "sourceEntry": 918,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "We had to stay in the cave. We couldn’t get back. The weather was so bad.",
      "src": "audio/pages/57/lines/008_pierce_7f135e102d8_norm.mp3",
      "duration": 4.458,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 9,
      "sourceEntry": 919,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "How inconvenient.",
      "src": "audio/pages/57/lines/009_monica_641b325a05f_norm.mp3",
      "duration": 1.115,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 10,
      "sourceEntry": 920,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "That’s why we were away for so long.",
      "src": "audio/pages/57/lines/010_pierce_7c00a863b96_norm.mp3",
      "duration": 2.043,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 11,
      "sourceEntry": 921,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "coming into the caravan, amused",
      "src": "audio/pages/57/lines/011_director_a029ed0daf2_norm.mp3",
      "duration": 1.273,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 12,
      "sourceEntry": 921,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "We wondered where you’d got to.",
      "src": "audio/pages/57/lines/012_parkes_15cc578ec9d_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 13,
      "sourceEntry": 922,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "yawns",
      "src": "audio/pages/57/lines/013_director_31809f88269_norm.mp3",
      "duration": 0.535,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 14,
      "sourceEntry": 922,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "I’ll help you in a little while, Parkes.",
      "src": "audio/pages/57/lines/014_pierce_244dfbbf9f8_norm.mp3",
      "duration": 2.09,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 15,
      "sourceEntry": 923,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "He makes no effort to move.",
      "src": "audio/pages/57/lines/015_director_1b276a82de0_norm.mp3",
      "duration": 1.079,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 16,
      "sourceEntry": 923,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Oh, I wouldn’t want to bother you, Pierce. You need your strength.",
      "src": "audio/pages/57/lines/016_parkes_5483c154159_norm.mp3",
      "duration": 3.39,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 17,
      "sourceEntry": 924,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "He squeezes his cloth into a bucket. Rushes out again. GWENDOLYN beams over MONICA and PENNY as they try to play cards.",
      "src": "audio/pages/57/lines/017_director_0ef895eb333_norm.mp3",
      "duration": 4.533,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 18,
      "sourceEntry": 924,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "And did you have a lovely day?",
      "src": "audio/pages/57/lines/018_gwendolyn_9caefc8c034_norm.mp3",
      "duration": 1.672,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 19,
      "sourceEntry": 925,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "MONICA looks at her with hate.",
      "src": "audio/pages/57/lines/019_director_5eeb361838a_norm.mp3",
      "duration": 1.135,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 20,
      "sourceEntry": 925,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Lovely! I can’t tell you how lovely.",
      "src": "audio/pages/57/lines/020_monica_873f4c6381a_norm.mp3",
      "duration": 1.95,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 21,
      "sourceEntry": 926,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "with admiration",
      "src": "audio/pages/57/lines/021_director_715d6c4e43f_norm.mp3",
      "duration": 0.831,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 22,
      "sourceEntry": 926,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Your eyes are absolutely sparkling, Gwendolyn.",
      "src": "audio/pages/57/lines/022_rodney_1426e5a78c9_norm.mp3",
      "duration": 2.415,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 23,
      "sourceEntry": 927,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Fluttering",
      "src": "audio/pages/57/lines/023_director_0292d4fc9b5_norm.mp3",
      "duration": 0.552,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 24,
      "sourceEntry": 927,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Thank you.",
      "src": "audio/pages/57/lines/024_gwendolyn_2d87cd5cdc2_norm.mp3",
      "duration": 0.882,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 25,
      "sourceEntry": 928,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Can I get you a drink?",
      "src": "audio/pages/57/lines/025_rodney_7d42af3cda2_norm.mp3",
      "duration": 1.115,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 26,
      "sourceEntry": 929,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "MONICA and PENNY hate him.",
      "src": "audio/pages/57/lines/026_director_c0e7f353fd7_norm.mp3",
      "duration": 1.277,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 27,
      "sourceEntry": 929,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "I don’t drink.",
      "src": "audio/pages/57/lines/027_gwendolyn_22f781505ea_norm.mp3",
      "duration": 1.068,
