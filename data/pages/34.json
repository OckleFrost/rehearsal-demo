      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 27,
      "sourceEntry": 526,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "This is a practically new caravan. How could you do that?",
