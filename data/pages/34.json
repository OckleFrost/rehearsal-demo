      "duration": 2.926,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 28,
      "sourceEntry": 527,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "I’m sorry. I banged my head. The tent fell on me...",
