      "duration": 6.966,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 5,
      "sourceEntry": 131,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "She moves against him seductively.",
      "src": "audio/pages/12/lines/005_director_d1418e8ace5a11d8_norm.mp3",
      "duration": 1.259,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 6,
      "sourceEntry": 131,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Penny. You surprise me. You really surprise me.",
