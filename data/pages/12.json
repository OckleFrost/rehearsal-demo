      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 3,
      "sourceEntry": 130,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Moving closer to him",
      "src": "audio/pages/12/lines/003_director_53d2ebbcb9356c87_norm.mp3",
      "duration": 0.896,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 4,
      "sourceEntry": 130,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Do you think we might make love while we’re here? There are sand hills on the beach, and it’s a very long beach.",
