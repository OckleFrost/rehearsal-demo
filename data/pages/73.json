    {
      "n": 16,
      "sourceEntry": 1180,
      "speaker": "MONICA",
      "kind": "spoken_offstage",
      "text": "Gwendolyn, you’re not in the caravan yet, dear. This is the annexe. Come on. Just a little further. Come on.",
