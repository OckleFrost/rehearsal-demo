      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 17,
      "sourceEntry": 1180,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_after_parse_split",
      "text": "Loud giggles from GWENDOLYN. MONICA and GWENDOLYN stagger into the caravan.",
