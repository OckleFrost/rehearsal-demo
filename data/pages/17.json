      "duration": 4.69,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 20,
      "sourceEntry": 224,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PARKES roars with laughter.",
