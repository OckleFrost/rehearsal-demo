      "duration": 1.013,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 21,
      "sourceEntry": 224,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "God, you’re funny, Monica. I’ve always wanted to get you away on a holiday.",
