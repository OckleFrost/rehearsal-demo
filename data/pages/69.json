      "duration": 2.786,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 3,
      "sourceEntry": 1101,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Oh. Yes.",
      "src": "audio/pages/69/lines/003_rodney_cb022f84ad0_norm.mp3",
      "duration": 0.65,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 4,
      "sourceEntry": 1101,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Pause",
      "src": "audio/pages/69/lines/004_director_360f0c227d7_norm.mp3",
