      "duration": 0.604,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 22,
      "sourceEntry": 1114,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "That’s it. Everything is out. The water’s almost up to the doorstep. If it gets any higher we have to leave.",
