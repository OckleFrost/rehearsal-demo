      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 20,
      "sourceEntry": 1113,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY stops laughing.",
      "src": "audio/pages/69/lines/020_director_09c55d4535c_norm.mp3",
      "duration": 0.803,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 21,
      "sourceEntry": 1113,
