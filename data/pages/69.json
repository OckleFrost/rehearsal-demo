      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 5,
      "sourceEntry": 1101,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Does that mean we won’t ever again? Ever.",
      "src": "audio/pages/69/lines/005_rodney_20994d610ef_norm.mp3",
      "duration": 1.904,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 6,
      "sourceEntry": 1102,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I don’t think so. Do you?",
      "src": "audio/pages/69/lines/006_penny_190f027406a_norm.mp3",
      "duration": 1.579,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 7,
      "sourceEntry": 1103,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Oh.",
      "src": "audio/pages/69/lines/007_rodney_9ece0ac8e73_norm.mp3",
      "duration": 0.418,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 8,
      "sourceEntry": 1104,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Why, did you want to?",
      "src": "audio/pages/69/lines/008_penny_56265d21297_norm.mp3",
      "duration": 1.486,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 9,
      "sourceEntry": 1105,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I enjoyed it. I really did, but.…",
      "src": "audio/pages/69/lines/009_rodney_11b373e4400_norm.mp3",
      "duration": 1.718,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 10,
      "sourceEntry": 1106,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "There’s always a “but” with you, Rodney.",
      "src": "audio/pages/69/lines/010_penny_1d5a05e1620_norm.mp3",
      "duration": 2.415,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 11,
      "sourceEntry": 1107,
      "speaker": "RODNEY",
      "kind": "spoken_parse_wrap_fix",
      "text": "I think we should keep our options open. We could meet for lunch one day when we get back to town.",
      "src": "audio/pages/69/lines/011_rodney_def40b348e5_norm.mp3",
      "duration": 4.133,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 12,
      "sourceEntry": 1107,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_after_parse_split",
      "text": "PENNY laughs. RODNEY laughs. Stops.",
      "src": "audio/pages/69/lines/012_director_337bafadc57_norm.mp3",
      "duration": 1.74,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 13,
      "sourceEntry": 1108,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "What’s so funny?",
      "src": "audio/pages/69/lines/013_rodney_c6ce3ab0ad2_norm.mp3",
      "duration": 1.022,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 14,
      "sourceEntry": 1109,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Loud",
      "src": "audio/pages/69/lines/014_director_3c7f01bd7f2_norm.mp3",
      "duration": 0.469,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 15,
      "sourceEntry": 1109,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You’re sure you wouldn’t like to go out to the car!",
      "src": "audio/pages/69/lines/015_penny_c4daf108d0f_norm.mp3",
      "duration": 2.554,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 16,
      "sourceEntry": 1110,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Sssh! Keep your voice down. Parkes might hear....",
      "src": "audio/pages/69/lines/016_rodney_fdee6843bf2_norm.mp3",
      "duration": 2.601,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 17,
      "sourceEntry": 1111,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PARKES enters with more luggage. PIERCE behind him, also with luggage. RODNEY jumps nervously.",
      "src": "audio/pages/69/lines/017_director_94eaeba31b3_norm.mp3",
      "duration": 6.022,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 18,
      "sourceEntry": 1111,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Ha. Ha. Ha.",
      "src": "audio/pages/69/lines/018_rodney_f5f0f644442_norm.mp3",
      "duration": 1.115,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 19,
      "sourceEntry": 1112,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "What’s so funny?",
