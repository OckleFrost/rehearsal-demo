      "duration": 3.437,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 25,
      "sourceEntry": 723,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "You’re not serious?",
