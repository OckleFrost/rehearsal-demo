      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 15,
      "sourceEntry": 716,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "How do you know? You don’t know that? Just because you haven’t seen them, doesn’t mean they’re not there.",
