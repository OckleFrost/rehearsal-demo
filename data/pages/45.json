      "duration": 5.201,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 16,
      "sourceEntry": 717,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "For God’s sake, let her get a word out. Darling, what happened?",
