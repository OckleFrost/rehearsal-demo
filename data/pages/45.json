      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 23,
      "sourceEntry": 722,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "MONICA shakes her head sadly at him.",
      "src": "audio/pages/45/lines/023_director_3250371999f_norm.mp3",
      "duration": 1.301,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 24,
      "sourceEntry": 722,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Rodney, Rodney. Sometimes I wonder. I wonder why I married you.",
