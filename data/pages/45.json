      "duration": 2.647,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 17,
      "sourceEntry": 718,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I...ah! Uh! I’m sorry. Let me get my breath. I ran all the way from the shower. My hands are shaking. Give me a brandy.",
