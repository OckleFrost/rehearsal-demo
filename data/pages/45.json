      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 18,
      "sourceEntry": 719,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Darling, what on earth happened?",
      "src": "audio/pages/45/lines/018_penny_325e5a040dd_norm.mp3",
      "duration": 1.811,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
