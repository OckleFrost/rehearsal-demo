      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 22,
      "sourceEntry": 721,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Don’t be silly. Who’d be able to rape you?",
