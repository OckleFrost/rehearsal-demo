      "duration": 5.433,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 18,
      "sourceEntry": 1130,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "And where does Penny sleep?",
