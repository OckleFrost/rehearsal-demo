      "duration": 1.62,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 21,
      "sourceEntry": 1132,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "It won’t hurt to all bunk in for one night.",
      "src": "audio/pages/70/lines/021_parkes_c9bc30d88d3_norm.mp3",
      "duration": 2.137,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 22,
      "sourceEntry": 1132,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Pause",
