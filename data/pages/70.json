      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 24,
      "sourceEntry": 1133,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "No, really, I don’t mind where I sleep.",
