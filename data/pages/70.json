      "duration": 0.898,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 6,
      "sourceEntry": 1120,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "She’s holding up well. When they built these caravans they built them to last. Don’t seem to be any more leaks in here, thank God.",
      "src": "audio/pages/70/lines/006_parkes_21a50c1e2b3_norm.mp3",
      "duration": 6.641,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 7,
      "sourceEntry": 1121,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Monica and Gwendolyn are a long time in the shower.",
      "src": "audio/pages/70/lines/007_pierce_e647646b1b8_norm.mp3",
      "duration": 2.786,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 8,
      "sourceEntry": 1122,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "It takes a long time. There are no lights.",
      "src": "audio/pages/70/lines/008_penny_4a4e597c957_norm.mp3",
      "duration": 2.508,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 9,
      "sourceEntry": 1123,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Where are we going to sleep? Let’s work that out.",
      "src": "audio/pages/70/lines/009_rodney_b1ed24a2986_norm.mp3",
      "duration": 2.137,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 10,
      "sourceEntry": 1124,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "We can’t use the sleeping bags. They’re soaking wet.",
      "src": "audio/pages/70/lines/010_pierce_e27f2dad900_norm.mp3",
      "duration": 3.019,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 11,
      "sourceEntry": 1125,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I’ll dry them on the heater.",
      "src": "audio/pages/70/lines/011_parkes_6c97e02c337_norm.mp3",
      "duration": 1.254,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 12,
      "sourceEntry": 1126,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "They’ll take hours to dry.",
      "src": "audio/pages/70/lines/012_pierce_33a8965b256_norm.mp3",
      "duration": 1.486,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 13,
      "sourceEntry": 1127,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "They won’t take hours!",
      "src": "audio/pages/70/lines/013_parkes_4d687bad90b_norm.mp3",
