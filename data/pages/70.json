      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 17,
      "sourceEntry": 1129,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Rodney, you sleep in the double bed, with Monica and I’ll take the sleeping bag. I don’t mind a bit of wet.",
