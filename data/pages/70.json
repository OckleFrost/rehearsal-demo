      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 19,
      "sourceEntry": 1131,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "The double bed fits three.",
      "src": "audio/pages/70/lines/019_parkes_70e8109605a_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 20,
      "sourceEntry": 1132,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "A stunned reaction from RODNEY and PENNY.",
