    {
      "n": 4,
      "sourceEntry": 1120,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Yes. Fine. I’m having a lovely time.",
      "src": "audio/pages/70/lines/004_parkes_704d15c88d6_norm.mp3",
      "duration": 2.368,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 5,
      "sourceEntry": 1120,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Pats caravan wall",
