      "src": "audio/pages/41/lines/017_director_b2dccb08550_norm.mp3",
      "duration": 0.624,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 18,
      "sourceEntry": 650,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Yes, Rodney.",
