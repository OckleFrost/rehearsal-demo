      "n": 1,
      "sourceEntry": 146,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I didn’t hear you. I’ve split my skull open.",
      "src": "audio/pages/13/lines/001_monica_1e00977a2e7836e6_norm.mp3",
      "duration": 2.322,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 2,
      "sourceEntry": 147,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "The pain will go in a minute. I did it too.",
      "src": "audio/pages/13/lines/002_penny_25696685e54175f6_norm.mp3",
      "duration": 2.322,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 3,
      "sourceEntry": 148,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "savagely",
      "src": "audio/pages/13/lines/003_director_fbbd8b54dbc149a5_norm.mp3",
      "duration": 0.529,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 4,
      "sourceEntry": 148,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "That doesn’t help me, does it? Give me a brandy.",
      "src": "audio/pages/13/lines/004_monica_aac004924ebca5d7_norm.mp3",
      "duration": 2.137,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 5,
      "sourceEntry": 149,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Monica, its ten o’clock in the morning.",
      "src": "audio/pages/13/lines/005_rodney_253d377ba11dfb96_norm.mp3",
      "duration": 1.858,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 6,
      "sourceEntry": 150,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Rodney, I’ve just given myself a brain haemorrhage. I need a brandy.",
      "src": "audio/pages/13/lines/006_monica_f07e5a77e70d896b_norm.mp3",
      "duration": 3.251,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 7,
      "sourceEntry": 151,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "There’s some white wine in the fridge.",
      "src": "audio/pages/13/lines/007_penny_dc541a7bc8740660_norm.mp3",
      "duration": 2.043,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 8,
      "sourceEntry": 152,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "A pause",
      "src": "audio/pages/13/lines/008_director_3ecdba628a1669b9_norm.mp3",
      "duration": 0.651,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 152,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "No brandy. Very well. We’ll go shopping later. I can’t get through this holiday without a brandy.",
      "src": "audio/pages/13/lines/009_monica_be82d5c0d96333a4_norm.mp3",
      "duration": 5.713,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 10,
      "sourceEntry": 153,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PENNY opens fridge and pours the wine from a cask. MONICA looks around the caravan with growing horror.",
      "src": "audio/pages/13/lines/010_director_9a9678de2eb94d74_norm.mp3",
      "duration": 3.66,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 11,
      "sourceEntry": 153,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I’m too tall for this caravan! Why didn’t you tell me it was built for midgets?",
      "src": "audio/pages/13/lines/011_monica_b6774b9ee3846b30_norm.mp3",
      "duration": 4.133,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 12,
      "sourceEntry": 154,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You’ve seen it before, darling.",
      "src": "audio/pages/13/lines/012_penny_d6b2cd30e42b87c0_norm.mp3",
      "duration": 1.811,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 13,
      "sourceEntry": 155,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I’ve never had to live in it before. Oh God. This is a terrible mistake.",
      "src": "audio/pages/13/lines/013_monica_0c312dc587c09937_norm.mp3",
      "duration": 4.133,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 14,
      "sourceEntry": 156,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Monica, we are going to be in this caravan for two weeks....",
      "src": "audio/pages/13/lines/014_rodney_83535e0325e495e4_norm.mp3",
      "duration": 2.926,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 15,
      "sourceEntry": 157,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "That long?",
      "src": "audio/pages/13/lines/015_monica_4979f3f38f2ccb5f_norm.mp3",
      "duration": 0.929,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 16,
      "sourceEntry": 158,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "This is only the first day. I would appreciate it very much if you would try to look on the bright side.",
      "src": "audio/pages/13/lines/016_rodney_146fd28e20fb8f17_norm.mp3",
      "duration": 4.644,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 17,
      "sourceEntry": 159,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "brightly",
      "src": "audio/pages/13/lines/017_director_99850f6cc1935563_norm.mp3",
      "duration": 0.397,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 18,
      "sourceEntry": 159,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "It’s really very comfortable.",
      "src": "audio/pages/13/lines/018_penny_c7d2e1617fe08a9e_norm.mp3",
      "duration": 1.579,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 19,
      "sourceEntry": 160,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "MONICA looks around, her face expressionless.",
      "src": "audio/pages/13/lines/019_director_ffd2f057f80f18a4_norm.mp3",
      "duration": 1.806,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 20,
      "sourceEntry": 160,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Really?",
      "src": "audio/pages/13/lines/020_monica_978b6f1e19f7cd48_norm.mp3",
      "duration": 0.743,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 21,
      "sourceEntry": 160,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "She drinks",
      "src": "audio/pages/13/lines/021_director_8632058ccc26c835_norm.mp3",
      "duration": 0.629,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 22,
      "sourceEntry": 160,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "God, that drive was awful. What with the heat, and the blow flies and the mosquitoes.",
      "src": "audio/pages/13/lines/022_monica_c52c2bc8c19ffcac_norm.mp3",
      "duration": 5.016,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 23,
      "sourceEntry": 161,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "She exaggerates. There was one fly.",
      "src": "audio/pages/13/lines/023_rodney_b07df28413c30557_norm.mp3",
      "duration": 1.718,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 24,
      "sourceEntry": 162,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "You wouldn’t notice. They don’t eat you. Well, they’ve got me all to themselves now. They can have a field day while I’m stuck out here. Are we still in New South Wales, by the way, or have we crossed the Nullarbor?",
      "src": "audio/pages/13/lines/024_monica_ae484fe2d30cc3fa_norm.mp3",
      "duration": 12.632,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 25,
      "sourceEntry": 163,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "laughing",
      "src": "audio/pages/13/lines/025_director_757afd3a4e9614c0_norm.mp3",
      "duration": 0.577,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 26,
      "sourceEntry": 163,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Monica, that’s why we invited you. You’re so funny.",
      "src": "audio/pages/13/lines/026_penny_a32e5787e99f6381_norm.mp3",
      "duration": 3.855,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    }
  ],
