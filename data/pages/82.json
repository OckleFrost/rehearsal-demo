  "lines": [
    {
      "n": 1,
      "sourceEntry": 1328,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Can’t we talk about this in the morning? Why don’t we just go to bed now? If you like, I’ll sleep in the car.",
      "src": "audio/pages/82/lines/001_parkes_dafd0cf3c50_norm.mp3",
      "duration": 4.923,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 2,
      "sourceEntry": 1329,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Please. Sleep with Monica. Be my guest. After all, I……-",
      "src": "audio/pages/82/lines/002_penny_66497c9a72f_norm.mp3",
      "duration": 4.876,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 3,
      "sourceEntry": 1330,
      "speaker": "MONICA_RODNEY",
      "kind": "same_text_duet",
      "text": "Penny!!!",
      "src": "audio/pages/82/lines/003_monica_rodney_08dab77_mix_norm.mp3",
      "duration": 0.789,
      "speed": null,
      "voiceName": "MONICA + RODNEY"
    },
    {
      "n": 4,
      "sourceEntry": 1331,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I thought we were going to try and be nice.",
      "src": "audio/pages/82/lines/004_parkes_1511d5288d5_norm.mp3",
      "duration": 1.95,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 5,
      "sourceEntry": 1332,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Don’t ever use that word to me again, or I’ll divorce you. I’m going home.",
      "src": "audio/pages/82/lines/005_penny_0d1ed84564e_norm.mp3",
      "duration": 4.644,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 6,
      "sourceEntry": 1333,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "What’s the use? All right. We’ll go home. I’ll pack up the car.",
      "src": "audio/pages/82/lines/006_parkes_b3464747a3f_norm.mp3",
      "duration": 3.251,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 7,
      "sourceEntry": 1334,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I’m not going. I’m staying.",
      "src": "audio/pages/82/lines/007_monica_ffacaa3b026_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 8,
      "sourceEntry": 1335,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "roars",
      "src": "audio/pages/82/lines/008_director_92d7caae3c7_norm.mp3",
      "duration": 0.499,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 1335,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "We are all going home!!",
      "src": "audio/pages/82/lines/009_parkes_a104af7190e_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 10,
      "sourceEntry": 1336,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I’m not. This holiday was your idea. Now you’ve got me here, I intend to enjoy it, even if it drowns me.",
      "src": "audio/pages/82/lines/010_monica_4d163d253dc_norm.mp3",
      "duration": 6.827,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 11,
      "sourceEntry": 1337,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "And it bloody well will because I’m taking the caravan.",
      "src": "audio/pages/82/lines/011_parkes_55a93fe7271_norm.mp3",
      "duration": 2.926,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 12,
      "sourceEntry": 1338,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "sweetly",
      "src": "audio/pages/82/lines/012_director_460893ea7f8_norm.mp3",
      "duration": 0.4,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 13,
      "sourceEntry": 1338,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You don’t all have to go just because I’m leaving.",
      "src": "audio/pages/82/lines/013_penny_66c81da1960_norm.mp3",
      "duration": 2.972,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 14,
      "sourceEntry": 1339,
      "speaker": "PARKES",
      "kind": "spoken_parse_wrap_fix",
      "text": "I can’t wait to leave! And I want to go now before we lose the caravan. What a holiday this turned out to be.",
      "src": "audio/pages/82/lines/014_parkes_1ee5ded40f4_norm.mp3",
      "duration": 5.619,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 15,
      "sourceEntry": 1339,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "He goes to the door.",
      "src": "audio/pages/82/lines/015_director_1eec788abb5_norm.mp3",
      "duration": 1.089,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 16,
      "sourceEntry": 1339,
      "speaker": "PARKES",
      "kind": "spoken_parse_wrap_fix",
      "text": "I’ll pack the car up in the pouring rain. Don’t anybody offer to help. Who needs friends.",
      "src": "audio/pages/82/lines/016_parkes_b71d91ea539_norm.mp3",
      "duration": 4.458,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 17,
      "sourceEntry": 1339,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_after_parse_split",
      "text": "PARKES exits. A pause.",
      "src": "audio/pages/82/lines/017_director_42351225be2_norm.mp3",
      "duration": 1.212,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 18,
      "sourceEntry": 1340,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Why did you have to tell him?",
      "src": "audio/pages/82/lines/018_monica_ef86f50b63a_norm.mp3",
      "duration": 1.347,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 19,
      "sourceEntry": 1341,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Why did you have to bring it up in the first place?",
      "src": "audio/pages/82/lines/019_penny_45c13025692_norm.mp3",
      "duration": 2.647,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 20,
      "sourceEntry": 1342,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "We’re friends. I thought I could.",
      "src": "audio/pages/82/lines/020_monica_d28665f2b11_norm.mp3",
      "duration": 1.718,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 21,
      "sourceEntry": 1343,
      "speaker": "PENNY",
      "kind": "spoken_parse_stage_split",
      "text": "Some things should never be brought up. That’s what friendship’s all about.",
      "src": "audio/pages/82/lines/021_penny_330e5c6e79b_norm.mp3",
      "duration": 4.133,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 22,
      "sourceEntry": 1343,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_after_parse_split",
      "text": "Another pause.",
      "src": "audio/pages/82/lines/022_director_e8f5b95c7de_norm.mp3",
      "duration": 0.798,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 23,
      "sourceEntry": 1344,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I’m sorry. I really am.",
      "src": "audio/pages/82/lines/023_monica_bc3959a0421_norm.mp3",
      "duration": 1.115,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 24,
      "sourceEntry": 1344,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Pause",
      "src": "audio/pages/82/lines/024_director_360f0c227d7_norm.mp3",
      "duration": 0.59,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 25,
      "sourceEntry": 1344,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "You’d better go. If you’re going.",
      "src": "audio/pages/82/lines/025_monica_32591d1cd56_norm.mp3",
      "duration": 1.672,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 26,
      "sourceEntry": 1345,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Yes.",
      "src": "audio/pages/82/lines/026_penny_ed73ae12d91_norm.mp3",
      "duration": 0.743,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    }
  ]
