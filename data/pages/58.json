    {
      "n": 2,
      "sourceEntry": 931,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "That’s all right. Thank you for asking.",
      "src": "audio/pages/58/lines/002_gwendolyn_3fee122daeb_norm.mp3",
      "duration": 2.043,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 3,
      "sourceEntry": 931,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "She sits down with RODNEY",
      "src": "audio/pages/58/lines/003_director_454418e91e2_norm.mp3",
      "duration": 1.072,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 4,
      "sourceEntry": 931,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "How’s the book coming along?",
      "src": "audio/pages/58/lines/004_gwendolyn_a00c99a1424_norm.mp3",
      "duration": 1.486,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 5,
      "sourceEntry": 932,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY throws the book over his shoulder nonchalantly.",
      "src": "audio/pages/58/lines/005_director_273795d614e_norm.mp3",
      "duration": 1.955,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 6,
      "sourceEntry": 932,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Oh, it’s not very interesting, you know.",
      "src": "audio/pages/58/lines/006_rodney_c7910ab98a1_norm.mp3",
      "duration": 1.95,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 7,
      "sourceEntry": 932,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "He grins idiotically, crosses his legs and gives her his full attention.",
      "src": "audio/pages/58/lines/007_director_449e750a8cc_norm.mp3",
      "duration": 2.54,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 8,
      "sourceEntry": 932,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Well. Tell me about your day.",
      "src": "audio/pages/58/lines/008_rodney_ead05aa3fc7_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 9,
      "sourceEntry": 933,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Oh, it was lovely.....",
      "src": "audio/pages/58/lines/009_gwendolyn_09ee33ec9e7_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 10,
      "sourceEntry": 934,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "MONICA and PENNY, go back to their cards, seething. PARKES rushes back in with his cloth and wrings it into the bucket. PIERCE, on the bunk, watches him.",
      "src": "audio/pages/58/lines/010_director_5d909e2fad6_norm.mp3",
      "duration": 7.311,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 11,
      "sourceEntry": 934,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "languidly",
      "src": "audio/pages/58/lines/011_director_507e834ba2d_norm.mp3",
      "duration": 0.502,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 12,
      "sourceEntry": 934,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Parkes, why don’t you take the bucket to the cloth instead of the cloth to the bucket?",
      "src": "audio/pages/58/lines/012_pierce_db54307bee6_norm.mp3",
      "duration": 4.458,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 13,
      "sourceEntry": 935,
      "speaker": "PARKES",
      "kind": "spoken_parse_wrap_fix",
      "text": "Because, Pierce, I have run out of buckets. The buckets are there to catch the drips. Do you realise we have five leaks in this caravan?",
      "src": "audio/pages/58/lines/013_parkes_f99c6411a60_norm.mp3",
      "duration": 8.963,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 14,
      "sourceEntry": 936,
      "speaker": "PIERCE",
      "kind": "spoken_parse_punctuation_fix",
      "text": "And there’s a flood in the annexe. I tell you, Parkes, Gwendolyn and I are not sleeping in there another night. It’s someone else’s turn.",
      "src": "audio/pages/58/lines/014_pierce_ef178d6e2ef_norm.mp3",
      "duration": 7.245,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 15,
      "sourceEntry": 937,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "All right. All right. We’ll toss for it.",
      "src": "audio/pages/58/lines/015_parkes_737f8f22213_norm.mp3",
      "duration": 1.997,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 16,
      "sourceEntry": 938,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "He rushes out with his cloth. PIERCE sits up.",
      "src": "audio/pages/58/lines/016_director_4c3a2a1d441_norm.mp3",
      "duration": 2.11,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 17,
      "sourceEntry": 938,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Good idea...",
      "src": "audio/pages/58/lines/017_pierce_8ba8dc368ce_norm.mp3",
      "duration": 0.929,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 18,
      "sourceEntry": 938,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "He takes out a coin",
      "src": "audio/pages/58/lines/018_director_96350fd6224_norm.mp3",
      "duration": 0.907,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 19,
      "sourceEntry": 938,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Heads, Parkes and Penny in the annexe. Tails, Monica and Rodney.",
      "src": "audio/pages/58/lines/019_pierce_cbda2fa0121_norm.mp3",
      "duration": 4.226,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 20,
      "sourceEntry": 939,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "He tosses. They watch.",
      "src": "audio/pages/58/lines/020_director_57c1e8fef04_norm.mp3",
      "duration": 1.214,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 21,
      "sourceEntry": 939,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Tails.",
      "src": "audio/pages/58/lines/021_pierce_7af835755c8_norm.mp3",
      "duration": 0.975,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 22,
      "sourceEntry": 939,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Cheerily",
      "src": "audio/pages/58/lines/022_director_a8a2bcfbee7_norm.mp3",
      "duration": 0.592,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 23,
      "sourceEntry": 939,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "That all right with you, Monica? Rodney?",
      "src": "audio/pages/58/lines/023_pierce_2bcb89fa09f_norm.mp3",
      "duration": 2.183,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 24,
      "sourceEntry": 940,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "We’re not sleeping out there!",
      "src": "audio/pages/58/lines/024_rodney_52e88190ac3_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 25,
      "sourceEntry": 941,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Yes. You are. We tossed for it.",
      "src": "audio/pages/58/lines/025_pierce_9a230fdbe48_norm.mp3",
      "duration": 2.508,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 26,
      "sourceEntry": 942,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Help Parkes clean it up. Quickly!",
      "src": "audio/pages/58/lines/026_monica_8990d8723b9_norm.mp3",
      "duration": 1.672,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    }
  ]
