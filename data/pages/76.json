    {
      "n": 8,
      "sourceEntry": 1219,
      "speaker": "RODNEY",
      "kind": "spoken_parse_wrap_fix",
      "text": "I wonder if you’ll be as honest in the morning when you’re sober.",
      "src": "audio/pages/76/lines/008_rodney_838ff8483c5_norm.mp3",
      "duration": 2.601,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 9,
      "sourceEntry": 1220,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You’re so understanding Monica. How can you be so understanding?",
      "src": "audio/pages/76/lines/009_penny_51c2d61c98b_norm.mp3",
      "duration": 3.994,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 10,
      "sourceEntry": 1221,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Darling, I know it only happened once. There hasn’t really been the opportunity on this holiday. And now you know I know I’ve probably dampened your enthusiasm. You see, I’m not really nice, after all.",
