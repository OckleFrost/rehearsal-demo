      "duration": 14.303,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 11,
      "sourceEntry": 1222,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You’re the nicest person I know! It did only happen once. It will never happen again.",
      "src": "audio/pages/76/lines/011_penny_6694d3ff004_norm.mp3",
      "duration": 5.294,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 12,
      "sourceEntry": 1223,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Daring, please don’t cry. I didn’t mean to upset you.",
