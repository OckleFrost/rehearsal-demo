      "duration": 3.136,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 22,
      "sourceEntry": 123,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Where do we all sleep?",
      "src": "audio/pages/11/lines/023_rodney_a8584021e41cd404_norm.mp3",
      "duration": 1.254,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 23,
      "sourceEntry": 124,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "There’s the double bed. Two bunks. And the annexe sleeps two.",
