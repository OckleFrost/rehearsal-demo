      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 8,
      "sourceEntry": 114,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I’ll have a surfie while I’m here.",
