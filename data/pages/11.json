      "duration": 1.393,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 15,
      "sourceEntry": 119,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Of course, I can’t compete with surfies, I realise that, but I’ve never had any complaints before.",
