      "duration": 4.319,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 24,
      "sourceEntry": 125,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Monica and I will have to take the annexe.",
      "src": "audio/pages/11/lines/025_rodney_effe41c973e6cef1_norm.mp3",
      "duration": 1.904,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 25,
      "sourceEntry": 126,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Why?",
