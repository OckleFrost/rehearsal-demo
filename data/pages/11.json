      "duration": 4.644,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 11,
      "sourceEntry": 117,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Oh. Go ahead then.",
      "src": "audio/pages/11/lines/012_rodney_d6d51927a4c0f9f3_norm.mp3",
