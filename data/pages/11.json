      "duration": 4.365,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 16,
      "sourceEntry": 120,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You were wonderful. But you don’t care. Don’t tell me you care.",
