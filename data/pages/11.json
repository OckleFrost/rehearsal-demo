      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 9,
      "sourceEntry": 115,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Oh, don’t be ridiculous.",
