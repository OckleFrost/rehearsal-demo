      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 26,
      "sourceEntry": 127,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I don’t think we should sleep in here with you and Parkes do you?",
