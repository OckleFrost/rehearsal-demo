      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 10,
      "sourceEntry": 116,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Why is that so ridiculous? They say young men are in their sexual prime.",
