      "duration": 5.48,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 17,
      "sourceEntry": 121,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I do. I do care. I’m guilty, that’s all. Adultery isn’t easy, Penny.",
