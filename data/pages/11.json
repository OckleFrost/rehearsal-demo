      "duration": 0.59,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 19,
      "sourceEntry": 121,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "It was a wonderful night. I did enjoy it. And I would have enjoyed it sober.",
      "src": "audio/pages/11/lines/020_rodney_659995618c99749d_norm.mp3",
      "duration": 3.437,
      "speed": null,
      "voiceName": "Ty Frost 25Minute"
    },
    {
      "n": 20,
      "sourceEntry": 122,
      "speaker": "PENNY",
      "kind": "spoken_parse_stage_split",
      "text": "Oh darling.",
      "src": "audio/pages/11/lines/021_penny_a56e232ba854a437_norm.mp3",
      "duration": 0.743,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 21,
