      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 6,
      "sourceEntry": 112,
      "speaker": "PENNY",
      "kind": "spoken_parse_wrap_fix",
      "text": "I haven’t fulfilled my womanhood!! I want to live more than twice a year!",
      "src": "audio/pages/11/lines/006_penny_65050387953900c9_norm.mp3",
      "duration": 4.923,
