      "duration": 4.551,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 13,
      "sourceEntry": 1370,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "They all look at him",
