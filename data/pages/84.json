      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 12,
      "sourceEntry": 1370,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Now I’d like to try and get the caravan out of the mud. Can anybody help?",
