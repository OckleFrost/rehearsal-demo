      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 2,
      "sourceEntry": 1293,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "In the hedge, actually.",
      "src": "audio/pages/80/lines/002_monica_2b202ca7b8a_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 3,
      "sourceEntry": 1294,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Don’t joke! Why do you always joke!",
