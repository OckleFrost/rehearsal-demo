      "voiceName": "Ty Frost 25Minute + KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM + Charlotte - Warm & Conversational + Dave - Expressive Australian English + James"
    },
    {
      "n": 6,
      "sourceEntry": 354,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "There is a long pause.",
      "src": "audio/pages/25/lines/006_director_f7d76fac6ad_norm.mp3",
      "duration": 0.972,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 7,
      "sourceEntry": 354,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Oh, isn’t this a lovely caravan!",
      "src": "audio/pages/25/lines/007_gwendolyn_afe1b41abf5_norm.mp3",
      "duration": 2.09,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 8,
      "sourceEntry": 355,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PARKES positively glows.",
      "src": "audio/pages/25/lines/008_director_6428b59b8c9_norm.mp3",
      "duration": 1.007,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 355,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "You like it? It’s got everything you could possibly want. Of course, we usually park over there, but some bugger’s.....blighter’s... taken my spot.",
      "src": "audio/pages/25/lines/009_parkes_d9e1101d7c2_norm.mp3",
      "duration": 9.474,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 10,
      "sourceEntry": 356,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "I think this is a lovely spot. I think the caravan’s lovely.",
      "src": "audio/pages/25/lines/010_gwendolyn_f443eeeff23_norm.mp3",
      "duration": 3.855,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 11,
      "sourceEntry": 357,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PARKES puts an arm around PENNY, the proud master of his domain.",
      "src": "audio/pages/25/lines/011_director_401cb18e92f_norm.mp3",
      "duration": 2.668,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 12,
      "sourceEntry": 357,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Thank you. We’re very pleased with it.",
      "src": "audio/pages/25/lines/012_parkes_4959189fc3b_norm.mp3",
      "duration": 1.95,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 13,
      "sourceEntry": 358,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "My father had a caravan. It was lovely. We had a lovely time. He and mummy bought it when they retired, too.",
      "src": "audio/pages/25/lines/013_gwendolyn_150e6a0a30c_norm.mp3",
      "duration": 7.105,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 14,
      "sourceEntry": 359,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "A moment.",
      "src": "audio/pages/25/lines/014_director_1c8f83e432b_norm.mp3",
      "duration": 0.561,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 15,
      "sourceEntry": 359,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I haven’t retired.",
      "src": "audio/pages/25/lines/015_parkes_a5523fcc6ce_norm.mp3",
      "duration": 1.115,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 16,
      "sourceEntry": 360,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Oh, I’m sorry, I thought....",
      "src": "audio/pages/25/lines/016_gwendolyn_cc1422e67ce_norm.mp3",
      "duration": 1.486,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 17,
      "sourceEntry": 361,
      "speaker": "MONICA",
      "kind": "spoken_parse_wrap_fix",
      "text": "No. None of us have quite reached retirement age yet. We’re the same age as Pierce.",
      "src": "audio/pages/25/lines/017_monica_2929e665621_norm.mp3",
      "duration": 4.598,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 18,
      "sourceEntry": 362,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PIERCE looks frightened.",
      "src": "audio/pages/25/lines/018_director_e2251ac3d40_norm.mp3",
      "duration": 0.989,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 19,
      "sourceEntry": 362,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Are you?",
      "src": "audio/pages/25/lines/019_gwendolyn_ff1682a0d61_norm.mp3",
      "duration": 0.743,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 20,
      "sourceEntry": 362,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Slightly bewildered.",
      "src": "audio/pages/25/lines/020_director_04183a6a020_norm.mp3",
      "duration": 0.907,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 21,
      "sourceEntry": 362,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "You can’t tell how old anybody is these days, can you? When I met Pierce, I thought he was about forty. And he’s only thirty-six.",
      "src": "audio/pages/25/lines/021_gwendolyn_46977572055_norm.mp3",
      "duration": 7.802,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 22,
      "sourceEntry": 362,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "They all look at PIERCE in surprise.",
      "src": "audio/pages/25/lines/022_director_61ba31fc6e0_norm.mp3",
      "duration": 1.301,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 23,
      "sourceEntry": 362,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "He was furious I thought he was forty. I told him it’s the debauched life he’s led, isn’t it Piercie, darling?",
      "src": "audio/pages/25/lines/023_gwendolyn_1490d380533_norm.mp3",
      "duration": 6.269,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 24,
      "sourceEntry": 363,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PIERCE smiles sheepishly. PENNY & MONICA giggle, and try to hide it.",
      "src": "audio/pages/25/lines/024_director_8cd4bc9f334_norm.mp3",
      "duration": 3.07,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 25,
      "sourceEntry": 363,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Fancy you thinking he was forty.",
      "src": "audio/pages/25/lines/025_parkes_08a508bfb1e_norm.mp3",
      "duration": 1.811,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 26,
      "sourceEntry": 364,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "And you’re all the same age?",
      "src": "audio/pages/25/lines/026_gwendolyn_b30466d0a66_norm.mp3",
      "duration": 1.533,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    }
  ],
