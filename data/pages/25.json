      "src": "audio/pages/25/lines/004_gwendolyn_cea9d31c59f_norm.mp3",
      "duration": 0.789,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 5,
      "sourceEntry": 353,
      "speaker": "ALL",
      "kind": "chorus",
      "text": "Hello!!!",
      "src": "audio/pages/25/lines/005_all_5_all_chorus_mix.mp3",
      "duration": 1.087,
