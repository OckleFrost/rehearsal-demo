  "lines": [
    {
      "n": 1,
      "sourceEntry": 993,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "He tries to get past PARKES with two buckets. PARKES tries to take them back from him.",
      "src": "audio/pages/62/lines/001_director_cada83688f6_norm.mp3",
      "duration": 3.092,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 2,
      "sourceEntry": 993,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Do you know how much this caravan cost?",
      "src": "audio/pages/62/lines/002_parkes_f953cdf6c1c_norm.mp3",
      "duration": 2.137,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 3,
      "sourceEntry": 994,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Whatever it was, you paid too much.",
      "src": "audio/pages/62/lines/003_rodney_14dbeae6c43_norm.mp3",
      "duration": 1.765,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 4,
      "sourceEntry": 995,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "erupts again",
      "src": "audio/pages/62/lines/004_director_358a6f64dfa_norm.mp3",
      "duration": 0.773,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 5,
      "sourceEntry": 995,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Right! Come outside!",
      "src": "audio/pages/62/lines/005_parkes_259acc360fd_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 6,
      "sourceEntry": 996,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Oh, don’t be childish.",
      "src": "audio/pages/62/lines/006_rodney_3db5b0e1799_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 7,
      "sourceEntry": 997,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Parkes, please darling....",
      "src": "audio/pages/62/lines/007_penny_1e85b2d2d31_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 8,
      "sourceEntry": 998,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "mad",
      "src": "audio/pages/62/lines/008_director_1c2663fe7f4_norm.mp3",
      "duration": 0.316,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 998,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I’ve asked you to come outside!",
      "src": "audio/pages/62/lines/009_parkes_123430b3a31_norm.mp3",
      "duration": 1.486,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 10,
      "sourceEntry": 999,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Don’t you touch my husband!",
      "src": "audio/pages/62/lines/010_monica_d4400452cd8_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 11,
      "sourceEntry": 1000,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "backing away",
      "src": "audio/pages/62/lines/011_director_50c9d8116ef_norm.mp3",
      "duration": 0.683,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 12,
      "sourceEntry": 1000,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I won’t fight you, Parkes. This is absolutely ridiculous....",
      "src": "audio/pages/62/lines/012_rodney_24bd8866d60_norm.mp3",
      "duration": 2.879,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 13,
      "sourceEntry": 1001,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "So you won’t fight? What sort of a man are you?",
      "src": "audio/pages/62/lines/013_parkes_c13328e15ba_norm.mp3",
      "duration": 2.461,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 14,
      "sourceEntry": 1002,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Surely we can talk this out in a sensible manner. Like two adults. I know that might be hard for you, but you could at least try.",
      "src": "audio/pages/62/lines/014_rodney_e9567c05365_norm.mp3",
      "duration": 5.713,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 15,
      "sourceEntry": 1003,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Right!",
      "src": "audio/pages/62/lines/015_parkes_30458a5bb30_norm.mp3",
      "duration": 0.65,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 16,
      "sourceEntry": 1004,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "He throws a punch at RODNEY but misses. RODNEY runs around the room, with PARKES swinging wildly at him. MONICA and PENNY try to stop them.",
      "src": "audio/pages/62/lines/016_director_490a07e049d_norm.mp3",
      "duration": 5.454,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 17,
      "sourceEntry": 1004,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Pierce, do something!",
      "src": "audio/pages/62/lines/017_penny_5d5120c3b50_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 18,
      "sourceEntry": 1005,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "ineffectually sitting up",
      "src": "audio/pages/62/lines/018_director_6efc82efb01_norm.mp3",
      "duration": 0.962,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 19,
      "sourceEntry": 1005,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Let’s not fight, fellas, eh? Let’s not be silly....",
      "src": "audio/pages/62/lines/019_pierce_86aa50143a9_norm.mp3",
      "duration": 3.297,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 20,
      "sourceEntry": 1006,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PARKES shoves him back on the bed. MONICA stands between PARKES and RODNEY.",
      "src": "audio/pages/62/lines/020_director_2d442086e7d_norm.mp3",
      "duration": 2.817,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 21,
      "sourceEntry": 1006,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "If you lay a finger on my husband you’ll have me to answer to.",
      "src": "audio/pages/62/lines/021_monica_af51ca6c667_norm.mp3",
      "duration": 3.019,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 22,
      "sourceEntry": 1007,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Get out of my way, Monica!",
      "src": "audio/pages/62/lines/022_parkes_81980afa3f1_norm.mp3",
      "duration": 1.486,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 23,
      "sourceEntry": 1008,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I will not.",
      "src": "audio/pages/62/lines/023_monica_5092d831c25_norm.mp3",
      "duration": 0.789,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 24,
      "sourceEntry": 1009,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I’m warning you.....",
      "src": "audio/pages/62/lines/024_parkes_6f724114410_norm.mp3",
      "duration": 1.115,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 25,
      "sourceEntry": 1010,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Oh yes? What will you do? Hit me?",
      "src": "audio/pages/62/lines/025_monica_ed30864bf26_norm.mp3",
      "duration": 1.95,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 26,
      "sourceEntry": 1011,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PARKES gives her a savage push. She topples into RODNEY and on to the bed.",
      "src": "audio/pages/62/lines/026_director_b5c1db4e640_norm.mp3",
      "duration": 3.071,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 27,
      "sourceEntry": 1011,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "hissing",
      "src": "audio/pages/62/lines/027_director_3129b1592b5_norm.mp3",
      "duration": 0.407,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 28,
      "sourceEntry": 1011,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "You pushed me!",
      "src": "audio/pages/62/lines/028_monica_f32c254a441_norm.mp3",
      "duration": 1.161,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    }
