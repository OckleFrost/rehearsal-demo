{
  "page": 79,
  "title": "Caravan — Page 79",
  "act": "Act Two",
  "source": "existing rendered rehearsal audio; bulk-indexed from accepted manifests; needs final display-copy QA before export",
  "status": "provisional-existing-render",
  "lines": [
    {
      "n": 1,
      "sourceEntry": 1272,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Monica, I don’t mind! I’m just a little hurt. You pretend to be my best friend and you’re off under a hedge with my husband.",
      "src": "audio/pages/79/lines/001_penny_a72a5b53670_norm.mp3",
      "duration": 8.034,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 2,
      "sourceEntry": 1273,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Once! Four years ago.",
      "src": "audio/pages/79/lines/002_monica_0df4c853cc4_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 3,
      "sourceEntry": 1274,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "And you keep your guilty little secret for four years!",
      "src": "audio/pages/79/lines/003_penny_35bc7354b02_norm.mp3",
      "duration": 3.622,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 4,
      "sourceEntry": 1275,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I’m not guilty!",
      "src": "audio/pages/79/lines/004_monica_26abb4debd3_norm.mp3",
      "duration": 1.254,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 5,
      "sourceEntry": 1276,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "No, obviously. I was! That’s the difference between you and me.",
      "src": "audio/pages/79/lines/005_penny_548e1da7c70_norm.mp3",
      "duration": 4.783,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 6,
      "sourceEntry": 1277,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Forget about it!",
      "src": "audio/pages/79/lines/006_monica_67b4768a998_norm.mp3",
      "duration": 1.254,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 7,
      "sourceEntry": 1278,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "I can’t forget about it! Please. Don’t give me any more of your understanding, Monica. It’s making me sick. You and Parkes-the very thought of it is ridiculous.",
      "src": "audio/pages/79/lines/007_penny_924d9746ffc_norm.mp3",
      "duration": 11.238,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 8,
      "sourceEntry": 1279,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "You said you didn’t mind.",
      "src": "audio/pages/79/lines/008_monica_928339a16a1_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 9,
      "sourceEntry": 1280,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Well, I do mind! I mind very much. How dare Parkes. How dare he!",
      "src": "audio/pages/79/lines/009_penny_366418ad5be_norm.mp3",
      "duration": 5.433,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 10,
      "sourceEntry": 1281,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "You did it to him.",
      "src": "audio/pages/79/lines/010_monica_329d2e81b05_norm.mp3",
      "duration": 1.254,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 11,
      "sourceEntry": 1282,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "That’s not the point! I put up with his tempers year in and year out and he’s off behind my back in a hedge!",
      "src": "audio/pages/79/lines/011_penny_2a942d87b18_norm.mp3",
      "duration": 6.037,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 12,
      "sourceEntry": 1283,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "We should rise above the body! I feel sea-sick!",
      "src": "audio/pages/79/lines/012_gwendolyn_83644c73e7a_norm.mp3",
      "duration": 2.601,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 13,
      "sourceEntry": 1284,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Shut up Gwendolyn, or I’ll put a pillow over your face and smother you.",
      "src": "audio/pages/79/lines/013_penny_a2eeac1a90f_norm.mp3",
      "duration": 4.133,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 14,
      "sourceEntry": 1285,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Don’t take your temper out on her. It’s not her fault.",
      "src": "audio/pages/79/lines/014_monica_9732e6559b4_norm.mp3",
      "duration": 2.879,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 15,
      "sourceEntry": 1286,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You’re defending her now! You’ve made her holiday a misery with your bitchy remarks.",
      "src": "audio/pages/79/lines/015_penny_ef9d2ea0c9b_norm.mp3",
      "duration": 4.969,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 16,
      "sourceEntry": 1287,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I have tried very hard to be pleasant in this prison camp.",
      "src": "audio/pages/79/lines/016_monica_da84d1d1c3d_norm.mp3",
      "duration": 3.111,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 17,
      "sourceEntry": 1288,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You didn’t try hard enough! You’ve winged day and night. Winge, winge, winge.",
      "src": "audio/pages/79/lines/017_penny_e08559f64c5_norm.mp3",
      "duration": 5.713,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 18,
      "sourceEntry": 1289,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Better than being wishy washy.",
      "src": "audio/pages/79/lines/018_monica_346af8405ae_norm.mp3",
      "duration": 1.672,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 19,
      "sourceEntry": 1290,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Don’t you call me wishy washy, you winger!",
      "src": "audio/pages/79/lines/019_penny_c54c6d50c46_norm.mp3",
      "duration": 2.368,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 20,
      "sourceEntry": 1291,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I thought we were going to have a week of niceness.",
      "src": "audio/pages/79/lines/020_monica_c9d220cc34f_norm.mp3",
      "duration": 2.368,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    }
  ]
}