      "kind": "spoken",
      "text": "No, I’m fine, thanks.",
      "src": "audio/pages/61/lines/002_gwendolyn_ef84d9f36ff_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 3,
      "sourceEntry": 977,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "She continues to watch on and beam. Then takes out a nail file and begins to file her nails. The noise is grating to MONICA and PENNY.",
      "src": "audio/pages/61/lines/003_director_42dc019f033_norm.mp3",
      "duration": 5.268,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 4,
      "sourceEntry": 977,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Can’t you see it’s getting worse? We need the bucket!",
      "src": "audio/pages/61/lines/004_rodney_e563fab2006_norm.mp3",
      "duration": 2.368,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 5,
      "sourceEntry": 978,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Put the bucket back!",
      "src": "audio/pages/61/lines/005_parkes_232e4644e51_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 6,
      "sourceEntry": 979,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "calling",
      "src": "audio/pages/61/lines/006_director_6aad4ec8b23_norm.mp3",
      "duration": 0.463,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 7,
      "sourceEntry": 979,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "How’s it going, boys?",
      "src": "audio/pages/61/lines/007_monica_4a28d815fd2_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 8,
      "sourceEntry": 980,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY runs in with the bucket. PARKES runs after him.",
      "src": "audio/pages/61/lines/008_director_1a0620af22e_norm.mp3",
      "duration": 2.104,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 980,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Put the bucket back!",
      "src": "audio/pages/61/lines/009_parkes_232e4644e51_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 10,
      "sourceEntry": 981,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "He collides with the door and bangs his head.",
      "src": "audio/pages/61/lines/010_director_953875faa05_norm.mp3",
      "duration": 1.717,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 11,
      "sourceEntry": 981,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Aaah! Bloody caravan!",
      "src": "audio/pages/61/lines/011_parkes_ed93f44ea7e_norm.mp3",
      "duration": 1.533,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 12,
      "sourceEntry": 982,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "He kicks the caravan.",
      "src": "audio/pages/61/lines/012_director_acae002ba0a_norm.mp3",
      "duration": 0.935,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 13,
      "sourceEntry": 982,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Parkes don’t hurt the caravan!",
      "src": "audio/pages/61/lines/013_penny_a055cac09de_norm.mp3",
      "duration": 1.765,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 14,
      "sourceEntry": 983,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "pats the caravan",
      "src": "audio/pages/61/lines/014_director_256ed021655_norm.mp3",
      "duration": 0.811,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 15,
      "sourceEntry": 983,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Oh sorry!",
      "src": "audio/pages/61/lines/015_parkes_9b57ba64033_norm.mp3",
      "duration": 0.882,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 16,
      "sourceEntry": 983,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Erupts again",
      "src": "audio/pages/61/lines/016_director_0416a952d21_norm.mp3",
      "duration": 0.68,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 17,
      "sourceEntry": 983,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Put the bucket back!",
      "src": "audio/pages/61/lines/017_parkes_232e4644e51_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 18,
      "sourceEntry": 984,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "There are two inches of water out there.",
      "src": "audio/pages/61/lines/018_rodney_bbb992348ef_norm.mp3",
      "duration": 1.811,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 19,
      "sourceEntry": 985,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "And there’ll be an inch in there, soon. I won’t have that.",
      "src": "audio/pages/61/lines/019_parkes_630651da906_norm.mp3",
      "duration": 2.461,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 20,
      "sourceEntry": 986,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY gets a glass.",
      "src": "audio/pages/61/lines/020_director_b761f2524f5_norm.mp3",
      "duration": 1.028,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 21,
      "sourceEntry": 986,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I’m putting a glass under the drip. All right, Parkes?",
      "src": "audio/pages/61/lines/021_rodney_23db5db1244_norm.mp3",
      "duration": 2.694,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 22,
      "sourceEntry": 987,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "No, it’s not all right, Rodney. Put the bucket back.",
      "src": "audio/pages/61/lines/022_parkes_62fd4a31f6b_norm.mp3",
      "duration": 2.368,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 23,
      "sourceEntry": 988,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "I will not.",
      "src": "audio/pages/61/lines/023_rodney_63388fdb7ee_norm.mp3",
      "duration": 0.929,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 24,
      "sourceEntry": 989,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I don’t like to have to remind you that you are a guest in my caravan, Rodney.",
      "src": "audio/pages/61/lines/024_parkes_9f1711963aa_norm.mp3",
      "duration": 4.412,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 25,
      "sourceEntry": 990,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "As your guest, I don’t intend to sleep in two inches of water.",
      "src": "audio/pages/61/lines/025_rodney_bea535db0bd_norm.mp3",
      "duration": 3.019,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 26,
      "sourceEntry": 991,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "erupting",
      "src": "audio/pages/61/lines/026_director_43414dd3271_norm.mp3",
      "duration": 0.47,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 27,
      "sourceEntry": 991,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "I’m cleaning the water up!",
      "src": "audio/pages/61/lines/027_parkes_fc264519008_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 28,
      "sourceEntry": 992,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Then use a bucket!",
      "src": "audio/pages/61/lines/028_rodney_5c8f177dac6_norm.mp3",
      "duration": 1.161,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    }
