      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 4,
      "sourceEntry": 770,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "We’re practically flooded.",
      "src": "audio/pages/49/lines/004_parkes_d637a27c374_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
