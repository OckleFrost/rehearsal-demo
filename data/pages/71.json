      "duration": 1.533,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 6,
      "sourceEntry": 1141,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "PARKES is dangerously close to losing his temper. PIERCE is very polite.",
