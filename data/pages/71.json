      "duration": 3.622,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 4,
      "sourceEntry": 1140,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "If Gwendolyn and Pierce took one bunk.",
