      "duration": 3.204,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 3,
      "sourceEntry": 1139,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "No. I’ll take the double bed with Penny. Er...Monica and Penny.",
