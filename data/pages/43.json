      "duration": 7.755,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 5,
      "sourceEntry": 672,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "I can’t go to bed while that stuff’s in the air.",
      "src": "audio/pages/43/lines/005_gwendolyn_36524706896_norm.mp3",
      "duration": 2.183,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 6,
      "sourceEntry": 672,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "PIERCE nudges her. She catches on",
      "src": "audio/pages/43/lines/006_director_890f84ca50d_norm.mp3",
      "duration": 1.466,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 7,
      "sourceEntry": 672,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Oh! Oh yes! Yes, I can.",
      "src": "audio/pages/43/lines/007_gwendolyn_6647b343c18_norm.mp3",
      "duration": 1.858,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 8,
      "sourceEntry": 672,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Sniffing heavily",
      "src": "audio/pages/43/lines/008_director_c3e0f18ced5_norm.mp3",
      "duration": 0.841,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 672,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "It’s not so bad now, is it?",
      "src": "audio/pages/43/lines/009_gwendolyn_9b6185abb09_norm.mp3",
      "duration": 1.579,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 10,
      "sourceEntry": 673,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "She beams at RODNEY and PENNY.",
