    {
      "n": 2,
      "sourceEntry": 670,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Would you like a drink?",
      "src": "audio/pages/43/lines/002_penny_9db17ed9cd7_norm.mp3",
      "duration": 1.347,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 3,
      "sourceEntry": 670,
      "speaker": "DIRECTOR",
      "kind": "trailing_page_stage_direction",
      "text": "A long silence. They all stand around, not knowing what to say.",
      "src": "audio/pages/43/lines/003_director_d0413753b55_norm.mp3",
      "duration": 3.07,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 4,
      "sourceEntry": 671,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "No, no thank you. We were just going to bed, too...I mean, just going to bed down. Lie down. Er...come along, Gwendolyn.",
