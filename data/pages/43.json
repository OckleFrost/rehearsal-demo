      "duration": 0.397,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 12,
      "sourceEntry": 673,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "There’s no need to go.",
