  "lines": [
    {
      "n": 1,
      "sourceEntry": 824,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "MONICA barely controls herself.",
      "src": "audio/pages/52/lines/001_director_75a0774f9cb_norm.mp3",
      "duration": 1.344,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 2,
      "sourceEntry": 824,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "We haven’t been able to go out. It’s natural we’re getting on each other’s nerves. Just a little bit.",
      "src": "audio/pages/52/lines/002_penny_e9c5e593227_norm.mp3",
      "duration": 5.759,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 3,
      "sourceEntry": 825,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Just a little bit. Yes.",
      "src": "audio/pages/52/lines/003_monica_f7c29e505c9_norm.mp3",
      "duration": 1.486,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 4,
      "sourceEntry": 826,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Monica, stop it!",
      "src": "audio/pages/52/lines/004_penny_0620161a162_norm.mp3",
      "duration": 1.347,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 5,
      "sourceEntry": 827,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "She takes a swig of brandy. A pause. RODNEY makes a valiant effort to change the subject.",
      "src": "audio/pages/52/lines/005_director_371bd980071_norm.mp3",
      "duration": 4.182,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 6,
      "sourceEntry": 827,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Where are the love birds?",
      "src": "audio/pages/52/lines/006_rodney_73ce04ff9d8_norm.mp3",
      "duration": 1.254,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 7,
      "sourceEntry": 828,
      "speaker": "PARKES",
      "kind": "spoken",
      "text": "Walking in the rain, again.",
      "src": "audio/pages/52/lines/007_parkes_a250a28c2e7_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "Dave - Expressive Australian English"
    },
    {
      "n": 8,
      "sourceEntry": 829,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "At least they’re making an effort to enjoy themselves.",
      "src": "audio/pages/52/lines/008_penny_0e732273210_norm.mp3",
      "duration": 2.972,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 9,
      "sourceEntry": 830,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "They’re probably at it, in a cave somewhere.",
      "src": "audio/pages/52/lines/009_monica_dc00c883221_norm.mp3",
      "duration": 2.276,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 10,
      "sourceEntry": 831,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "fascinated",
      "src": "audio/pages/52/lines/010_director_571039655c9_norm.mp3",
      "duration": 0.566,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 11,
      "sourceEntry": 831,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "Not in a cave? In a cave? You think that’s what they’re doing?",
      "src": "audio/pages/52/lines/011_penny_472919371d4_norm.mp3",
      "duration": 4.505,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 12,
      "sourceEntry": 832,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "They don’t seem to do much at night.",
      "src": "audio/pages/52/lines/012_monica_6dc34ee5919_norm.mp3",
      "duration": 1.904,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 13,
      "sourceEntry": 833,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "You don’t listen?",
      "src": "audio/pages/52/lines/013_penny_2ad7f20aa94_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 14,
      "sourceEntry": 834,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Of course. Don’t you?",
      "src": "audio/pages/52/lines/014_monica_38c08939042_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 15,
      "sourceEntry": 835,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "The poor girl’s probably inhibited. After all, she was three years in an Ashram.",
      "src": "audio/pages/52/lines/015_penny_9ce573a41d6_norm.mp3",
      "duration": 5.016,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 16,
      "sourceEntry": 836,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Better than six days in a caravan.",
      "src": "audio/pages/52/lines/016_monica_e14831e44d4_norm.mp3",
      "duration": 1.997,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 17,
      "sourceEntry": 837,
      "speaker": "PENNY",
      "kind": "spoken",
      "text": "It’s very inhibiting being in a confined space with six people.",
      "src": "audio/pages/52/lines/017_penny_b30e2feebef_norm.mp3",
      "duration": 3.808,
      "speed": null,
      "voiceName": "KYLIE - AUSTRALIAN FEMALE FRIENDLY WARM"
    },
    {
      "n": 18,
      "sourceEntry": 838,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Oh, I don’t know. Rodney and I managed once.",
      "src": "audio/pages/52/lines/018_monica_9bcffce89c9_norm.mp3",
      "duration": 1.997,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 19,
      "sourceEntry": 839,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PENNY is stunned. She turns to RODNEY. He’s deep in his book and doesn’t hear.",
      "src": "audio/pages/52/lines/019_director_87384a3d568_norm.mp3",
      "duration": 2.974,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 20,
      "sourceEntry": 839,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "But only once. I think he finds his book more interesting. Don’t you, dear?",
      "src": "audio/pages/52/lines/020_monica_1ca7865da67_norm.mp3",
      "duration": 4.273,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 21,
      "sourceEntry": 840,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Mmmm?",
      "src": "audio/pages/52/lines/021_rodney_c367e750d26_norm.mp3",
      "duration": 0.743,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 22,
      "sourceEntry": 841,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "I said we managed it once.",
      "src": "audio/pages/52/lines/022_monica_27a53c65be3_norm.mp3",
      "duration": 1.393,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    },
    {
      "n": 23,
      "sourceEntry": 842,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "looking up",
      "src": "audio/pages/52/lines/023_director_2034c3d2537_norm.mp3",
      "duration": 0.435,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 24,
      "sourceEntry": 842,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Managed what?",
      "src": "audio/pages/52/lines/024_rodney_a123a0cc308_norm.mp3",
      "duration": 0.975,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 25,
      "sourceEntry": 843,
      "speaker": "MONICA",
      "kind": "spoken",
      "text": "Never mind, you’ve probably forgotten.",
      "src": "audio/pages/52/lines/025_monica_b40c140dd68_norm.mp3",
      "duration": 1.95,
      "speed": null,
      "voiceName": "Charlotte - Warm & Conversational"
    }
  ]
}