      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 4,
      "sourceEntry": 659,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Oh, it’s stinging my eyes!",
      "src": "audio/pages/42/lines/004_gwendolyn_0dcdc086d86_norm.mp3",
      "duration": 1.765,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 5,
      "sourceEntry": 660,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "GWENDOLYN enters the caravan backwards, sneezing loudly.",
      "src": "audio/pages/42/lines/005_director_eb4787cbd4f_norm.mp3",
      "duration": 2.047,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 6,
      "sourceEntry": 660,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "I’m allergic to sprays.",
      "src": "audio/pages/42/lines/006_gwendolyn_bc2ed9bfa20_norm.mp3",
      "duration": 1.533,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 7,
      "sourceEntry": 661,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PENNY and RODNEY panic. PENNY manages to hide in the double bed. It’s too late for RODNEY. He quickly sits at the table, and feverishly reaches for some matches he sees, and tries to nonchalantly light a cigarette, as GWENDOLYN appears in the doorway with her back to him.",
      "src": "audio/pages/42/lines/007_director_1a73fffed97_norm.mp3",
      "duration": 11.175,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 8,
      "sourceEntry": 661,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "sneezing and coughing",
      "src": "audio/pages/42/lines/008_director_96d21028ca6_norm.mp3",
      "duration": 0.89,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 9,
      "sourceEntry": 661,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "I won’t be able to sleep in there. I’m allergic. I get very bad allergies.....",
      "src": "audio/pages/42/lines/009_gwendolyn_90cbdd1840e_norm.mp3",
      "duration": 4.644,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 10,
      "sourceEntry": 662,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "GWENDOLYN turns and sees RODNEY.",
      "src": "audio/pages/42/lines/010_director_cb868b9dc09_norm.mp3",
      "duration": 1.297,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 11,
      "sourceEntry": 662,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "Aahhh!",
      "src": "audio/pages/42/lines/011_gwendolyn_f6780369b82_norm.mp3",
      "duration": 0.65,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 12,
      "sourceEntry": 663,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "RODNEY totally falls to pieces. GWENDOLYN’S scream makes him throw the matches in the air. To cover his confusion he tries to drink a glass of wine, forgetting he still has the cigarette in his mouth. He tosses the empty glass casually over his shoulder, and smokes the wet cigarette.",
      "src": "audio/pages/42/lines/012_director_888b0897b70_norm.mp3",
      "duration": 11.742,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 13,
      "sourceEntry": 663,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Just making the bed.",
      "src": "audio/pages/42/lines/013_rodney_ab355fe8920_norm.mp3",
      "duration": 1.3,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 14,
      "sourceEntry": 664,
      "speaker": "GWENDOLYN",
      "kind": "spoken",
      "text": "I didn’t know you were in here.",
      "src": "audio/pages/42/lines/014_gwendolyn_1fee93937cf_norm.mp3",
      "duration": 1.579,
      "speed": null,
      "voiceName": "Lily - Velvety Actress"
    },
    {
      "n": 15,
      "sourceEntry": 665,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Yes. Making the bed.",
      "src": "audio/pages/42/lines/015_rodney_3188028d2b3_norm.mp3",
      "duration": 1.207,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 16,
      "sourceEntry": 666,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PIERCE enters with his can of insect repellent.",
      "src": "audio/pages/42/lines/016_director_b81d5498da7_norm.mp3",
      "duration": 1.869,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 17,
      "sourceEntry": 666,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "It’s all right, darling. It’ll go in a minute. Better to be safe than sorry.",
      "src": "audio/pages/42/lines/017_pierce_4c4bd816c62_norm.mp3",
      "duration": 4.598,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 18,
      "sourceEntry": 666,
      "speaker": "DIRECTOR",
      "kind": "inline_stage_direction",
      "text": "Seeing RODNEY",
      "src": "audio/pages/42/lines/018_director_a6e91f11598_norm.mp3",
      "duration": 0.838,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 19,
      "sourceEntry": 666,
      "speaker": "PIERCE",
      "kind": "spoken",
      "text": "Where did you spring from?",
      "src": "audio/pages/42/lines/019_pierce_c456a3a1019_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "James"
    },
    {
      "n": 20,
      "sourceEntry": 667,
      "speaker": "RODNEY",
      "kind": "spoken",
      "text": "Helping Penny make the bed.",
      "src": "audio/pages/42/lines/020_rodney_3d37a120714_norm.mp3",
      "duration": 1.44,
      "speed": null,
      "voiceName": "Ty Frost private clone"
    },
    {
      "n": 21,
      "sourceEntry": 668,
      "speaker": "DIRECTOR",
      "kind": "stage_direction_before",
      "text": "PIERCE and GWENDOLYN look around the caravan for PENNY. They look back at RODNEY. He swallows nervously. The curtains open slowly and a very annoyed PENNY emerges.",
      "src": "audio/pages/42/lines/021_director_0b139e8a91a_norm.mp3",
      "duration": 7.19,
      "speed": "1.5x",
      "voiceName": "Ockle Jane - Dry Wit"
    },
    {
      "n": 22,
      "sourceEntry": 668,
      "speaker": "DIRECTOR",
